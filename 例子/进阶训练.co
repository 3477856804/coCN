# ============================================================
# 进阶训练：展示优化器家族 + L1 损失 + 梯度裁剪 + 模型保存/加载
#
# 训练一个两层回归网络拟合 y = 2x + 1（带轻微噪声）。
# 用 Adam 自适应优化、平均绝对误差(L1) 稳健损失、梯度裁剪防爆炸；
# 训练后保存模型，再加载到全新参数，验证预测逐样本一致。
# ============================================================

让 学习率 = 0.01
让 样本数 = 24
让 隐层数 = 8

# 生成训练数据：x 均匀分布在 [-2, 2]，y = 2x + 1（带轻微噪声）
让 xs = []
让 ys = []
对于 i 从 0 到 样本数 - 1 循环
    让 x = 随机数() * 4.0 - 2.0
    让 y = 2.0 * x + 1.0 + (随机数() - 0.5) * 0.2
    追加(xs, x)
    追加(ys, y)
结束

# 参数初始化（全部需梯度）
让 w1 = 需梯度(高斯随机([1, 隐层数], 0, 0.5))
让 b1 = 需梯度(全零([1, 隐层数]))
让 w2 = 需梯度(高斯随机([隐层数, 1], 0, 0.5))
让 b2 = 需梯度(全零([1, 1]))

函数 前向(浮点 x) -> 张量
    让 隐层 = 线性整流(矩阵乘(张量([[x]]), w1) + b1)  # [1, 隐层数]
    返回 矩阵乘(隐层, w2) + b2                        # [1, 1]
结束

函数 评估损失() -> 浮点
    让 总 = 0.0
    对于 i 从 0 到 样本数 - 1 循环
        总 = 总 + 取(平均绝对误差(前向(xs[i]), 张量([[ys[i]]])), 0)
    结束
    返回 总 / 样本数
结束

# 逐样本训练三件套：前向 → 反向 → (裁剪 + 优化)
输出 "初始平均MAE损失 ", 评估损失()
对于 轮 从 1 到 600 循环
    对于 i 从 0 到 样本数 - 1 循环
        让 预测 = 前向(xs[i])
        让 目标 = 张量([[ys[i]]])
        反向(平均绝对误差(预测, 目标))
        裁剪梯度(5.0, [w1, b1, w2, b2])        # 防梯度爆炸
        Adam(学习率, [w1, b1, w2, b2])         # 自适应步长优化
    结束
    如果 轮 % 150 == 0
        输出 "轮次 ", 轮, "  平均MAE损失 ", 评估损失()
    结束
结束

# 保存 / 加载模型
保存模型("/tmp/co回归模型.bin", [w1, b1, w2, b2])
让 新w1 = 张量([[0, 0, 0, 0, 0, 0, 0, 0]])
让 新b1 = 张量([[0, 0, 0, 0, 0, 0, 0, 0]])
让 新w2 = 张量([[0], [0], [0], [0], [0], [0], [0], [0]])
让 新b2 = 张量([[0]])
加载模型("/tmp/co回归模型.bin", [新w1, 新b1, 新w2, 新b2])

函数 加载后前向(浮点 x) -> 张量
    让 隐层 = 线性整流(矩阵乘(张量([[x]]), 新w1) + 新b1)
    返回 矩阵乘(隐层, 新w2) + 新b2
结束

# 验证：加载后的参数应与原参数给出逐样本一致的预测
让 一致 = 真
让 平均偏差 = 0.0
对于 i 从 0 到 样本数 - 1 循环
    让 x = xs[i]
    让 偏差 = 绝对值(取(前向(x), 0, 0) - 取(加载后前向(x), 0, 0))
    平均偏差 = 平均偏差 + 偏差
    如果 偏差 > 0.0001 那么 一致 = 假 结束
结束
平均偏差 = 平均偏差 / 样本数

如果 一致 且 平均偏差 < 0.0001
    输出 "模型保存/加载往返完全一致（平均偏差 ", 平均偏差, "）：训练全流程通过"
否则
    输出 "模型往返不一致！平均偏差 ", 平均偏差
结束

删除文件("/tmp/co回归模型.bin")