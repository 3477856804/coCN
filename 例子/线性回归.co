# 线性回归（带自动求导）
# 拟合 y = 2*x + 1
# 运行: ./co 例子/线性回归.co

让 学习率 = 0.1

# 参数（需梯度 才会参与反向传播）
让 w = 需梯度(高斯随机([1, 1], 0, 0.1))
让 b = 需梯度(全零([1, 1]))

# 数据
让 x = 张量([[0.0], [1.0], [-1.0], [0.5]])
让 y = 张量([[1.0], [3.0], [-1.0], [2.0]])

对于 轮 从 0 到 200 循环
    让 预测 = 矩阵乘(x, w) + b
    让 损失 = 均方误差(预测, y)
    反向(损失)            # 自动求导
    优化(学习率, [w, b])  # SGD 更新参数并清零梯度
    如果 轮 % 50 == 0 则
        输出 "轮", 轮, "损失", 取(损失, 0, 0)
    结束
结束

输出 "训练完成: w =", 取(w, 0, 0), "b =", 取(b, 0, 0), "(期望约 w=2, b=1)"
