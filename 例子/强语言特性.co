导入 "标准库"

# ============================================================
# 强语言特性演示：静态类型 / 模块 / 推导式 / 模式匹配
# ============================================================

# 1) 渐进式静态类型标注（标注的变量会被类型检查）
整数 n = 10
浮点 pi = 3.14159
字符串 名字 = "coCN"
布尔 标志 = 真

输出 "阶乘(5) =", 阶乘(n - 5)
输出 "求和([1,2,3,4]) =", 求和([1, 2, 3, 4])
输出 "平均值([2,4,6]) =", 平均值([2, 4, 6])
输出 "反转('hello') =", 反转字符串("hello")
输出 "是素数(17) =", 是素数(17)
输出 "安全比值(10,3) =", 安全比值(10.0, 3.0)

# 2) 列表推导式：[x*x 对于 x 于 列表 若 条件]
列表 奇数平方 = [x * x 对于 x 于 [1, 2, 3, 4, 5, 6] 若 x % 2 == 1]
输出 "奇数平方 =", 奇数平方

# 3) 字典推导式：{键: 长度(键) 对于 键, 值 于 字典}
字典 词长 = {w: 长度(w) 对于 w, v 于 {"苹果": 1, "香蕉": 2, "西瓜": 3}}
输出 "词长 =", 词长

# 4) 模式匹配
整数 状态码 = 2
匹配 状态码
    是 1: 输出 "状态: 就绪"
    是 2: 输出 "状态: 运行中"
    是 3: 输出 "状态: 完成"
    默认: 输出 "状态: 未知"
结束

# 5) 类型标注的函数签名（参数与返回类型均被检查）
函数 加(整数 a, 整数 b) -> 整数
    返回 a + b
结束
输出 "加(3, 4) =", 加(3, 4)
