# 多分类演示（对数交叉熵 + softmax 的稳定实现）
# 训练一个简单的线性分类器
# 运行: ./co 例子/分类演示.co

让 学习率 = 0.5

# 特征（2 维），标签为 0/1/2
让 x = 张量([[1.0, 0.5], [0.5, 1.0], [0.2, 0.2], [0.8, 0.9]])
让 标签 = 张量([[0.0], [1.0], [2.0], [1.0]])

让 w = 需梯度(高斯随机([2, 3], 0, 1))
让 b = 需梯度(全零([1, 3]))

对于 轮 从 0 到 300 循环
    让 logits = 矩阵乘(x, w) + b
    让 损失 = 对数交叉熵(logits, 标签)
    反向(损失)
    优化(学习率, [w, b])
    如果 轮 % 100 == 0 则
        输出 "轮", 轮, "损失", 取(损失, 0, 0)
    结束
结束

输出 "=== 最终 logits（每行最大值所在列应为对应标签）==="
输出 矩阵乘(x, w) + b
输出 "=== 概率分布（柔性最大值 / softmax）==="
输出 柔性最大值(矩阵乘(x, w) + b)
