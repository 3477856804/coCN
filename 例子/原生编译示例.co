# 原生编译后端 MVP 演示：覆盖 整数/浮点/布尔/字符串、算术/比较/逻辑/位运算、
# 控制流、函数(递归)、以及常用内置。
# 本文件是「双通道一致性」的基准用例：
#   解释器  ./co 例子/原生编译示例.co
#   原生    ./co --编译 例子/原生编译示例.co /tmp/demo && /tmp/demo
# 两者的标准输出必须逐字节相同。

# ---- 字面量与进制 ----
整数 a = 0xFF
整数 b = 0b1010
整数 c = 0o777
整数 d = 1_000_000
输出("进制:", a, b, c, d)

# ---- 算术与比较 ----
浮点 x = 3.5
整数 y = 2
输出("真除:", x / y)
输出("整除:", 7 // 2)
输出("取模:", 7 % 3)
输出("比较:", 3 > 2, 2 >= 2, 1 < 0, 5 == 5)

# ---- 逻辑（短路）----
布尔 t = 真 且 (3 > 2)
布尔 f = 假 或 (1 > 2)
输出("逻辑:", t, f)
# 短路验证：右侧的除零绝不能被求值
布尔 sc = 假 且 (1 / 0 > 0)
布尔 so = 真 或 (1 / 0 > 0)
输出("短路:", sc, so)

# ---- 位运算 ----
整数 m = 0b1100
整数 n = 0b1010
输出("按位:", m & n, m | n, m ^ n, ~m, m << 2, m >> 1)
输出("负算术右移:", -8 >> 1)

# ---- 字符串 ----
字符串 s = "你好coCN"
输出("拼接:", "a" + "b" + 转字符串(123))
输出("长度(字符):", 长度(s))
输出("下标:", s[0], s[2])
输出("字节数:", 字节数(s))
输出("字节:", 字节(s, 0), 字节(s, -1))
输出("大小写:", 大写("abcXYZ你好"), 小写("ABCxyz你好"))
输出("去空白:", "[" + 去空白("  hi  ") + "]", "[" + 去左空白("  hi  ") + "]", "[" + 去右空白("  hi  ") + "]")
输出("重复:", 重复("ab", 3))
输出("前后缀:", 开头是("coCN语言", "co"), 结尾是("coCN语言", "语言"))
输出("码点:", 字符码("A"), 字符码(s, 0), 码转字符(20320))
输出("截取:", 截取(s, 0, 2), 截取(s, -4, 4))
输出("查找:", 查找(s, "coCN"), 查找(s, "无"))
输出("替换:", 替换("a-b-c", "-", "+"))

# ---- 控制流：如果/否则若/否则 ----
整数 score = 85
如果 score >= 90 则
    输出("等级: 优")
否则若 score >= 80 则
    输出("等级: 良")
否则
    输出("等级: 其他")
结束

# ---- 当 循环 + 跳出/继续 ----
整数 i = 0
当 i < 10 循环
    i = i + 1
    如果 i == 3 则 继续 结束
    如果 i == 8 则 跳出 结束
    如果 i % 2 == 0 则 输出("当-偶数:", i) 结束
结束

# ---- 对于 循环（含步长、浮点）----
对于 k 从 0 到 5 步长 2 循环
    输出("步长循环:", k)
结束
对于 fk 从 0.0 到 1.0 步长 0.25 循环
    输出("浮点循环:", fk)
结束

# ---- 函数：递归（斐波那契）----
函数 斐波那契(n)
    如果 n < 2 则 返回 n 结束
    返回 斐波那契(n - 1) + 斐波那契(n - 2)
结束
输出("斐波那契(10):", 斐波那契(10))

# ---- 函数：互递归 ----
函数 偶(n)
    如果 n == 0 则 返回 真 结束
    返回 奇(n - 1)
结束
函数 奇(n)
    如果 n == 0 则 返回 假 结束
    返回 偶(n - 1)
结束
输出("偶(4):", 偶(4), "奇(7):", 奇(7))

# ---- 函数：带参计算 + 返回 ----
函数 圆面积(r)
    返回 圆周率() * r * r
结束
输出("圆面积(2):", 圆面积(2.0))

# ---- 内置：数值与转换 ----
输出("取整:", 取整(3.6), 向下取整(-2.3), 向上取整(2.1), 截断(-2.9))
输出("绝对值/符号:", 绝对值(-42), 符号(-7), 符号(0), 符号(9))
输出("幂/根/对数:", 幂(2, 10), 平方根(16), 自然对数(1))
输出("三角:", 正弦(0), 余弦(0), 正切(0), 最大值(3, 7), 最小值(3, 7))
输出("类型:", 类型(1), 类型(1.0), 类型(真), 类型("x"))
输出("转换:", 转整数("42"), 转浮点("2.5"), 转布尔(0), 转字符串(3.5))
输出("进制格式化:", 十六进制(255), 二进制(10), 八进制(64))
输出("位工具:", 位计数(0b1011), 取位(0b1010, 1), 置位(0b0000, 2, 1))

# ---- 全局变量被函数引用 ----
整数 全局基数 = 100
函数 加基(v)
    返回 v + 全局基数
结束
输出("加基(5):", 加基(5))
