# ============================================================
# 系统信息与文本处理：演示 格式化 / 环境变量 / 时钟毫秒 /
# 复制 / 合并字典 / 读取行 / /tmp 临时文件
# ============================================================

# ---------- 1) 字符串格式化：{} 占位符按序替换 ----------
让 名称 = "coCN"
让 版本号 = 0.1
输出 格式化("语言: {}，版本: {}", 名称, 版本号)
输出 格式化("{} × {} = {}", 6, 7, 6 * 7)

# ---------- 2) 环境变量：读取系统环境 ----------
让 系统 = 环境变量("OS")
如果 系统 != ""
    输出 格式化("当前操作系统环境变量 OS = {}", 系统)
否则
    输出 "环境变量 OS 未设置"
结束
设置环境变量("COCN_DEMO", "中文演示")
断言相等(环境变量("COCN_DEMO"), "中文演示")

# ---------- 3) 高精度计时：时钟毫秒 ----------
让 起点 = 时钟毫秒()
对于 i 从 0 到 99999 循环
    让 占位 = i * i
结束
让 耗时 = 时钟毫秒() - 起点
输出 格式化("十万次平方耗时 {} 毫秒", 耗时)

# ---------- 4) 复制：列表浅拷贝与字符串独立副本 ----------
让 原始表 = [1, 2, 3]
让 备份表 = 复制(原始表)
追加(备份表, 4)
输出 格式化("原表: {}；备份表: {}", 原始表, 备份表)
断言相等(原始表, [1, 2, 3])          # 原表不受影响

让 原文 = "不可变"
让 副本 = 复制(原文)
副本 = 副本 + "（已改）"
输出 格式化("原文: {}；副本: {}", 原文, 副本)

# ---------- 5) 合并字典：把源字典并入目标 ----------
让 配置 = {"学习率": 0.01, "轮数": 100}
让 补充 = {"动量": 0.9, "轮数": 200}
合并字典(配置, 补充)
输出 格式化("合并后配置: {}", 配置)
断言相等(配置["动量"], 0.9)          # 新增键
断言相等(配置["轮数"], 200)          # 同名键被覆盖

# ---------- 6) /tmp 临时文件与读取行 ----------
写文件("/tmp/co配置.txt", "甲:1")
追加文件("/tmp/co配置.txt", "\n乙:2")
追加文件("/tmp/co配置.txt", "\n丙:3")
让 行表 = 读取行("/tmp/co配置.txt")
输出 格式化("配置文件共 {} 行，第二行: {}", 长度(行表), 行表[1])
断言相等(行表[1], "乙:2")
删除文件("/tmp/co配置.txt")
断言(非 文件存在("/tmp/co配置.txt"), "临时文件已清理")

# ---------- 7) 组合应用：格式化的 JSON 风格输出 ----------
让 数据 = {"名字": "小明", "得分": 95, "及格": 真}
输出 "{" + 格式化("\"名字\": \"{}\", \"得分\": {}, \"及格\": {}", 数据["名字"], 数据["得分"], 数据["及格"]) + "}"

输出 "系统信息演示：全部通过"
