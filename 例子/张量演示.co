# 张量基础演示
# 运行: ./co 例子/张量演示.co

# 1) 从嵌套列表构造张量（自动推断形状）
让 a = 张量([[1, 2, 3], [4, 5, 6]])
输出 "a =", a
输出 "a 的形状 =", 形状(a)

# 2) 一维张量
让 v = 张量([10, 20, 30])
输出 "v =", v
输出 "v[1] =", 取(v, 1)

# 3) 元素级运算（支持广播）
让 b = a + 张量([[1, 1, 1], [1, 1, 1]])
输出 "a + 1 =", b

# 4) 矩阵乘法
让 w = 张量([[1, 0], [0, 1], [2, 2]])
输出 "a * w =", 矩阵乘(a, w)

# 5) 转置
输出 "a 的转置 =", 转置(a)

# 6) 规约
输出 "a 所有元素之和 =", 求和(a)
输出 "a 的平均值 =", 均值(a)

# 7) 随机张量与激活函数
让 r = 高斯随机([2, 3], 0, 1)
输出 "随机张量形状 =", 形状(r)
输出 "对 r 做西格莫德(部分) =", 西格莫德(张量([[0, 2], [-3, 5]]))
输出 "对 r 做线性整流 =", 线性整流(张量([[-1, 2], [3, -4]]))

# 8) 原地修改元素
置(v, 0, 999)
输出 "修改后 v =", v
置(a, 0, 2, 888)
输出 "修改后 a =", a
