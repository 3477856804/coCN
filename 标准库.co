# ============================================================
# 标准库.co —— coCN 官方标准库
# 通过  导入 "标准库"  引入；所有顶层函数会被合并到调用方环境
#
# 命名约定：本文件中的函数名一律【不与内置函数重名】，
# 避免遮蔽内置实现（例如内置的 求和 用于张量，此处不再重复定义）。
# ============================================================

# ---------------- 数值 ----------------

# 阶乘（递归）
函数 阶乘(整数 n) -> 整数
    若 n <= 1 返回 1
    返回 n * 阶乘(n - 1)
结束

# 平方 / 立方
函数 平方(x)
    返回 x * x
结束

函数 立方(x)
    返回 x * x * x
结束

# 最大公约数（辗转相除）
函数 最大公约(整数 a, 整数 b) -> 整数
    整数 x = 绝对值(a)
    整数 y = 绝对值(b)
    当 y != 0 循环
        整数 t = y
        y = x % y
        x = t
    结束
    返回 x
结束

# 最小公倍数
函数 最小公倍(整数 a, 整数 b) -> 整数
    若 a == 0 或 b == 0 返回 0
    返回 绝对值(a * b) // 最大公约(a, b)
结束

# 素数判断（只试除到平方根，比逐个试除快一个数量级）
函数 是素数(整数 n) -> 布尔
    若 n < 2 返回 假
    若 n < 4 返回 真
    若 n % 2 == 0 返回 假
    整数 上界 = 向下取整(平方根(n))
    对于 i 从 3 到 上界 步长 2 循环
        若 n % i == 0 返回 假
    结束
    返回 真
结束

# 小于 n 的所有素数（埃氏筛思路的简化版）
函数 素数表(整数 n)
    列表 结果 = []
    对于 i 从 2 到 n - 1 循环
        若 是素数(i) 追加(结果, i)
    结束
    返回 结果
结束

# 夹取数值到 [下界, 上界]
函数 夹取(x, 下界, 上界)
    若 x < 下界 返回 下界
    若 x > 上界 返回 上界
    返回 x
结束

# 把 a/b 夹到 [-1, 1]，并对除零做保护
函数 安全比值(浮点 a, 浮点 b) -> 浮点
    若 b == 0.0 返回 0.0
    返回 夹取(a / b, -1.0, 1.0)
结束

# 斐波那契（迭代版，避免指数级重复计算）
函数 斐波那契(整数 n) -> 整数
    若 n < 2 返回 n
    整数 前 = 0
    整数 后 = 1
    对于 i 从 2 到 n 循环
        整数 和 = 前 + 后
        前 = 后
        后 = 和
    结束
    返回 后
结束

# ---------------- 统计 ----------------

# 平均值
函数 平均值(列表 表)
    若 长度(表) == 0 返回 0.0
    返回 累加(表) / 长度(表)
结束

# 中位数（不改动原列表）
函数 中位数(列表 表)
    整数 n = 长度(表)
    若 n == 0 返回 0.0
    列表 副本 = 切片(表, 0, n)
    排序(副本)
    若 n % 2 == 1 返回 副本[n // 2]
    返回 (副本[n // 2 - 1] + 副本[n // 2]) / 2
结束

# 方差（总体方差）
函数 方差(列表 表)
    整数 n = 长度(表)
    若 n == 0 返回 0.0
    浮点 均 = 平均值(表)
    浮点 s = 0.0
    对于 i 从 0 到 n - 1 循环
        s = s + (表[i] - 均) * (表[i] - 均)
    结束
    返回 s / n
结束

# 标准差
函数 标准差(列表 表)
    返回 平方根(方差(表))
结束

# ---------------- 字符串 ----------------

# 字符串反转（内置 反转 已支持字符串，此处保留为语义化别名）
函数 反转字符串(字符串 s) -> 字符串
    返回 反转(s)
结束

# 是否回文（按字符比较，中文安全）
函数 是回文(字符串 s) -> 布尔
    返回 s == 反转(s)
结束

# 左侧补齐到指定字符宽度
函数 左补齐(字符串 s, 整数 宽, 字符串 填充) -> 字符串
    字符串 r = s
    当 长度(r) < 宽 循环
        r = 填充 + r
    结束
    返回 r
结束

# 右侧补齐到指定字符宽度
函数 右补齐(字符串 s, 整数 宽, 字符串 填充) -> 字符串
    字符串 r = s
    当 长度(r) < 宽 循环
        r = r + 填充
    结束
    返回 r
结束

# 首字母大写（仅处理 ASCII 首字符）
函数 首字大写(字符串 s) -> 字符串
    若 长度(s) == 0 返回 s
    返回 大写(切片(s, 0, 1)) + 切片(s, 1)
结束

# ---------------- 列表 ----------------

# 两个列表按位配对成 [[a1,b1], [a2,b2], ...]
函数 配对(列表 甲, 列表 乙)
    整数 n = 最小值(长度(甲), 长度(乙))
    列表 结果 = []
    对于 i 从 0 到 n - 1 循环
        追加(结果, [甲[i], 乙[i]])
    结束
    返回 结果
结束

# 按块大小切分列表
函数 分块(列表 表, 整数 块大小)
    若 块大小 <= 0 返回 []
    列表 结果 = []
    整数 i = 0
    当 i < 长度(表) 循环
        追加(结果, 切片(表, i, i + 块大小))
        i = i + 块大小
    结束
    返回 结果
结束

# 统计各元素出现次数，返回字典（键为元素的字符串形式）
函数 频次(列表 表)
    字典 结果 = {}
    对于 i 从 0 到 长度(表) - 1 循环
        字符串 k = 转字符串(表[i])
        若 包含(结果, k) 结果[k] = 结果[k] + 1
        若 非 包含(结果, k) 结果[k] = 1
    结束
    返回 结果
结束
