# ============================================================
# 自举编译器.co —— 用 coCN 自己写的编译器（首次自举的 L1 编译器）
#
# 它把 coCN 的一个【精简子集】(.co) 编译成 C，再调用 cc 产出独立二进制。
# 用法（三级流水线）：
#   1) ./co --编译 自举编译器.co 自举cc      # 用现在 C 写的编译器，编译本编译器
#   2) 把要编译的 demo 源码存为 自举输入.co
#   3) ./自举cc                              # → 生成 自举产物.c 并 cc 出 自举输出
#   4) ./自举输出                             # 运行，与解释器 ./co 自举输入.co 逐字节一致
#
# 自举机制 = “用我们的语言写编译器，再用现有的 C 编译器编译它”。
# 本编译器源码用到的 列表/字符串/文件IO/递归，由 真实原生后端 编译；
# 它产出的 C 只覆盖精简子集（变量/算术/比较/控制流/输出/断言，整数循环）。
# 结构约定：多分支一律写成守卫（若...返回/继续），不用 否则若 长链，避免深层嵌套歧义。
# ============================================================

让 g标记表 = []
让 g位置 = 0
让 g名字表 = []
让 g临时N = 0
让 g输出 = ""
让 g源 = ""
让 g函数代码 = ""        # 函数定义生成的 C（置于 main 之前）
让 g函数表 = []          # 每项 [函数名, 序号]
让 g在函数 = 假          # 真=发射进 g函数代码
让 g函数N = 0

# ---------- 词法辅助 ----------
函数 是数字(字符串 c) -> 布尔
    返回 c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 或 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9"
结束

函数 是符号字符(字符串 c) -> 布尔
    返回 c == "+" 或 c == "-" 或 c == "*" 或 c == "/" 或 c == "%" 或 c == "=" 或 c == "<" 或 c == ">" 或 c == "!" 或 c == "(" 或 c == ")" 或 c == "." 或 c == ","
结束

函数 是关键(字符串 词) -> 布尔
    返回 词 == "让" 或 词 == "变量" 或 词 == "常量" 或 词 == "输出" 或 词 == "断言" 或 词 == "如果" 或 词 == "若" 或 词 == "则" 或 词 == "否则" 或 词 == "当" 或 词 == "循环" 或 词 == "对于" 或 词 == "从" 或 词 == "到" 或 词 == "步长" 或 词 == "且" 或 词 == "或" 或 词 == "非" 或 词 == "真" 或 词 == "假" 或 词 == "空" 或 词 == "函数" 或 词 == "返回"
结束

# ---------- 词法分析（守卫结构，不用 elif 长链） ----------
函数 词法(字符串 源) -> 列表
    列表 表 = []
    整数 n = 长度(源)
    整数 p = 0
    当 p < n 循环
        字符串 c = 源[p]
        若 c == "\n"
            追加(表, ["符号", "NL"])
            p = p + 1
            继续
        结束
        若 c == " " 或 c == "\t" 或 c == "\r"
            p = p + 1
            继续
        结束
        若 c == "#"
            当 p < n 循环
                若 源[p] == "\n"
                    跳出
                结束
                p = p + 1
            结束
            继续
        结束
        若 是数字(c)
            整数 起 = p
            布尔 浮 = 假
            当 p < n 循环
                c = 源[p]
                若 是数字(c) 或 c == "."
                    若 c == "."
                        浮 = 真
                    结束
                    p = p + 1
                否则
                    跳出
                结束
            结束
            字符串 词 = 截取(源, 起, p - 起)
            若 浮
                追加(表, ["浮点", 词])
            否则
                追加(表, ["整数", 词])
            结束
            继续
        结束
        若 c == "\""
            p = p + 1
            字符串 内容 = ""
            整数 在串 = 1
            当 p < n 且 在串 == 1 循环
                若 源[p] == "\""
                    在串 = 0
                    p = p + 1
                否则若 源[p] == "\\" 且 p + 1 < n
                    字符串 e = 源[p + 1]
                    若 e == "n"
                        内容 = 内容 + "\n"
                    否则若 e == "t"
                        内容 = 内容 + "\t"
                    否则若 e == "\""
                        内容 = 内容 + "\""
                    否则若 e == "\\"
                        内容 = 内容 + "\\"
                    否则
                        内容 = 内容 + e
                    结束
                    p = p + 2
                否则
                    内容 = 内容 + 源[p]
                    p = p + 1
                结束
            结束
            追加(表, ["字符串", 内容])
            继续
        结束
        若 是符号字符(c)
            若 c == "/" 且 p + 1 < n 且 源[p + 1] == "/"
                追加(表, ["符号", "//"])
                p = p + 2
            否则若 c == "=" 且 p + 1 < n 且 源[p + 1] == "="
                追加(表, ["符号", "=="])
                p = p + 2
            否则若 c == "!" 且 p + 1 < n 且 源[p + 1] == "="
                追加(表, ["符号", "!="])
                p = p + 2
            否则若 c == "<" 且 p + 1 < n 且 源[p + 1] == "="
                追加(表, ["符号", "<="])
                p = p + 2
            否则若 c == ">" 且 p + 1 < n 且 源[p + 1] == "="
                追加(表, ["符号", ">="])
                p = p + 2
            否则
                追加(表, ["符号", c])
                p = p + 1
            结束
            继续
        结束
        整数 起2 = p
        当 p < n 循环
            字符串 cc = 源[p]
            若 cc == " " 或 cc == "\n" 或 cc == "\t" 或 cc == "\r"
                跳出
            结束
            若 是符号字符(cc)
                跳出
            结束
            若 cc == "\""
                跳出
            结束
            若 cc == "#"
                跳出
            结束
            p = p + 1
        结束
        字符串 词2 = 截取(源, 起2, p - 起2)
        若 是关键(词2)
            追加(表, ["关键字", 词2])
        否则
            追加(表, ["标识符", 词2])
        结束
    结束
    追加(表, ["符号", "EOF"])
    返回 表
结束

# ---------- 记号读取 ----------
函数 词类() -> 字符串
    返回 g标记表[g位置][0]
结束

函数 词值() -> 字符串
    返回 g标记表[g位置][1]
结束

函数 前进()
    若 g标记表[g位置][1] != "EOF"
        g位置 = g位置 + 1
    结束
结束

函数 期待(字符串 期望)
    若 词值() != 期望
        报错("期望 '" + 期望 + "'，实际是 '" + 词值() + "'")
        返回
    结束
    前进()
结束

函数 报错(字符串 消息)
    输出错误("自举编译器: 第" + 转字符串(g位置) + "个记号处: " + 消息)
    断言(假, "编译失败：" + 消息)
结束

# ---------- demo 变量映射 ----------
函数 varid(字符串 名) -> 整数
    整数 n = 长度(g名字表)
    对于 i 从 0 到 n - 1 循环
        若 g名字表[i][1] == 名
            返回 i
        结束
    结束
    返回 -1
结束

函数 注册名字(字符串 名)
    若 varid(名) == -1
        追加(g名字表, [名, 名])
    结束
结束

# 预扫描：把所有 demo 变量名登记进 g名字表（C 需要先声明再引用）
函数 登记全部名字()
    整数 n = 长度(g标记表)
    整数 i = 0
    当 i < n 循环
        若 g标记表[i][1] == "让" 或 g标记表[i][1] == "变量" 或 g标记表[i][1] == "常量"
            若 i + 1 < n 且 g标记表[i + 1][0] == "标识符"
                注册名字(g标记表[i + 1][1])
            结束
            i = i + 1
            继续
        结束
        若 g标记表[i][1] == "对于"
            若 i + 1 < n 且 g标记表[i + 1][0] == "标识符"
                注册名字(g标记表[i + 1][1])
            结束
            i = i + 1
            继续
        结束
        若 g标记表[i][0] == "标识符"
            若 i + 1 < n 且 g标记表[i + 1][1] == "="
                注册名字(g标记表[i][1])
            结束
        结束
        i = i + 1
    结束
结束

# ---------- 发射生成的 C ----------
函数 发射(字符串 行)
    若 g在函数
        g函数代码 = g函数代码 + 行
        返回
    结束
    g输出 = g输出 + 行
结束

函数 新临时() -> 字符串
    字符串 t = "_t" + 转字符串(g临时N)
    g临时N = g临时N + 1
    返回 t
结束

函数 C串(字符串 s) -> 字符串
    返回 替换(替换(s, "\\", "\\\\"), "\"", "\\\"")
结束

函数 二进制(字符串 op, 字符串 l, 字符串 r) -> 字符串
    字符串 t = 新临时()
    发射("  CoVal " + t + " = vbin(" + l + ", \"" + op + "\", " + r + ");\n")
    返回 t
结束

# ---------- 表达式（优先级：或<且<比较<加减<乘除<一元<主要） ----------
函数 emit_or() -> 字符串
    字符串 l = emit_and()
    当 词值() == "或" 循环
        前进()
        字符串 r = emit_and()
        字符串 t = 新临时()
        发射("  CoVal " + t + " = cvb(cvtruthy(" + l + ")||cvtruthy(" + r + "));\n")
        l = t
    结束
    返回 l
结束

函数 emit_and() -> 字符串
    字符串 l = emit_cmp()
    当 词值() == "且" 循环
        前进()
        字符串 r = emit_cmp()
        字符串 t = 新临时()
        发射("  CoVal " + t + " = cvb(cvtruthy(" + l + ")&&cvtruthy(" + r + "));\n")
        l = t
    结束
    返回 l
结束

函数 emit_cmp() -> 字符串
    字符串 l = emit_add()
    当 词值() == "==" 或 词值() == "!=" 或 词值() == "<" 或 词值() == "<=" 或 词值() == ">" 或 词值() == ">=" 循环
        字符串 op = 词值()
        前进()
        字符串 r = emit_add()
        l = 二进制(op, l, r)
    结束
    返回 l
结束

函数 emit_add() -> 字符串
    字符串 l = emit_mul()
    当 词值() == "+" 或 词值() == "-" 循环
        字符串 op = 词值()
        前进()
        字符串 r = emit_mul()
        l = 二进制(op, l, r)
    结束
    返回 l
结束

函数 emit_mul() -> 字符串
    字符串 l = emit_unary()
    当 词值() == "*" 或 词值() == "/" 或 词值() == "//" 或 词值() == "%" 循环
        字符串 op = 词值()
        前进()
        字符串 r = emit_unary()
        l = 二进制(op, l, r)
    结束
    返回 l
结束

函数 emit_unary() -> 字符串
    若 词值() == "-"
        前进()
        字符串 e = emit_unary()
        字符串 t = 新临时()
        发射("  CoVal " + t + " = vneg(" + e + ");\n")
        返回 t
    结束
    若 词值() == "非"
        前进()
        字符串 e = emit_unary()
        字符串 t = 新临时()
        发射("  CoVal " + t + " = cvb(!cvtruthy(" + e + "));\n")
        返回 t
    结束
    返回 emit_primary()
结束

函数 emit_primary() -> 字符串
    若 词类() == "整数"
        字符串 v = 词值()
        前进()
        字符串 t = 新临时()
        发射("  CoVal " + t + " = cvi(" + v + ");\n")
        返回 t
    结束
    若 词类() == "浮点"
        字符串 v = 词值()
        前进()
        字符串 t = 新临时()
        发射("  CoVal " + t + " = cvf(" + v + ");\n")
        返回 t
    结束
    若 词类() == "字符串"
        字符串 v = 词值()
        前进()
        字符串 t = 新临时()
        发射("  CoVal " + t + " = cvss(\"" + C串(v) + "\");\n")
        返回 t
    结束
    若 词类() == "关键字"
        字符串 v = 词值()
        若 v == "真"
            前进()
            字符串 t = 新临时()
            发射("  CoVal " + t + " = cvb(1);\n")
            返回 t
        结束
        若 v == "假"
            前进()
            字符串 t = 新临时()
            发射("  CoVal " + t + " = cvb(0);\n")
            返回 t
        结束
        若 v == "空"
            前进()
            字符串 t = 新临时()
            发射("  CoVal " + t + " = cvnull();\n")
            返回 t
        结束
        报错("意外关键字 '" + v + "'")
        返回 ""
    结束
    若 词类() == "符号" 且 词值() == "("
        前进()
        字符串 e = emit_or()
        期待(")")
        返回 e
    结束
    若 词类() == "标识符"
        字符串 名 = 词值()
        前进()
        若 词值() == "("
            # 函数调用（目前无参）
            整数 函数号 = -1
            整数 nn = 长度(g函数表)
            对于 j 从 0 到 nn - 1 循环
                若 g函数表[j][0] == 名
                    函数号 = g函数表[j][1]
                结束
            结束
            若 函数号 == -1
                报错("调用了未定义函数 '" + 名 + "'")
                返回 ""
            结束
            前进()          # 跳过 (
            期待(")")
            返回 "f_" + 转字符串(函数号) + "()"
        结束
        整数 id = varid(名)
        若 id == -1
            报错("未定义变量 '" + 名 + "'")
            返回 ""
        结束
        返回 "V" + 转字符串(id)
    结束
    报错("表达式应为数字/字符串/变量/括号，实际是 '" + 词值() + "'")
    返回 ""
结束

# 期望一条语句后的换行（分号）；块收尾词也视为合法
函数 期待换行()
    若 词值() == "NL"
        前进()
        返回
    结束
    若 词值() == "结束" 或 词值() == "否则" 或 词值() == "EOF"
        返回
    结束
    报错("语句后应换行，实际是 '" + 词值() + "'")
结束

# 解析并发射一段语句块（跳过行首/空行的换行，遇到 结束/否则 停止）
函数 解析块()
    当 词值() != "结束" 且 词值() != "否则" 且 词值() != "EOF" 循环
        若 词值() == "NL"
            前进()
            继续
        结束
        解析语句()
    结束
结束

# 单条语句（守卫结构）
函数 解析语句()
    字符串 k = 词值()
    若 k == "让" 或 k == "变量" 或 k == "常量"
        前进()
        字符串 名 = 词值()
        前进()
        期待("=")
        字符串 v = emit_or()
        整数 id = varid(名)
        若 id == -1
            报错("内部错误：变量未登记 '" + 名 + "'")
        结束
        发射("  V" + 转字符串(id) + " = " + v + ";\n")
        期待换行()
        返回
    结束
    若 k == "输出"
        前进()
        字符串 v = emit_or()
        字符串 t = 新临时()
        发射("  CoVal " + t + " = " + v + ";\n")
        发射("  { char *_os = cvi2s(" + t + "); printf(\"%s\\n\", _os); free(_os); }\n")
        期待换行()
        返回
    结束
    若 k == "断言"
        前进()
        期待("(")
        字符串 v = emit_or()
        期待(")")
        字符串 t = 新临时()
        发射("  CoVal " + t + " = " + v + ";\n")
        发射("  if(!cvtruthy(" + t + ")){ fprintf(stderr, \"断言失败\\n\"); exit(1); }\n")
        期待换行()
        返回
    结束
    若 k == "如果" 或 k == "若"
        前进()
        字符串 c = emit_or()
        期待("则")
        字符串 t = 新临时()
        发射("  CoVal " + t + " = " + c + ";\n")
        发射("  if (cvtruthy(" + t + ")) {\n")
        解析块()
        若 词值() == "否则"
            前进()
            发射("  } else {\n")
            解析块()
            若 词值() == "结束"
                前进()
            结束
            发射("  }\n")
        结束
        若 词值() == "结束"
            前进()
            发射("  }\n")
        结束
        期待换行()
        返回
    结束
    若 k == "当"
        前进()
        发射("  for(;;){\n")
        字符串 c = emit_or()
        期待("循环")
        字符串 t = 新临时()
        发射("    CoVal " + t + " = " + c + ";\n")
        发射("    if(!cvtruthy(" + t + ")) break;\n")
        解析块()
        若 词值() == "结束"
            前进()
        结束
        发射("  }\n")
        期待换行()
        返回
    结束
    若 k == "对于"
        前进()
        字符串 名 = 词值()
        前进()
        整数 id = varid(名)
        若 id == -1
            报错("内部错误：循环变量未登记 '" + 名 + "'")
        结束
        期待("从")
        字符串 a = emit_or()
        期待("到")
        字符串 b = emit_or()
        字符串 s = ""
        整数 有步长 = 0
        若 词值() == "步长"
            前进()
            s = emit_or()
            有步长 = 1
        结束
        期待("循环")
        字符串 ta = 新临时()
        发射("  CoVal " + ta + " = " + a + ";\n")
        字符串 tb = 新临时()
        发射("  CoVal " + tb + " = " + b + ";\n")
        字符串 ts = 新临时()
        若 有步长 == 1
            发射("  CoVal " + ts + " = " + s + ";\n")
        否则
            发射("  CoVal " + ts + " = cvi(1);\n")
        结束
        发射("  { double _f = cvnum(" + ta + "), _t = cvnum(" + tb + "), _s = cvnum(" + ts + ");\n")
        发射("    if(_s == 0){ fprintf(stderr, \"循环步长不能为0\\n\"); exit(1); }\n")
        发射("    double _i = _f; int _d = (_s > 0) ? 1 : -1;\n")
        发射("    for(; ((_d>0&&_i<=_t+1e-4)||(_d<0&&_i>=_t-1e-4)); _i += _s){\n")
        发射("      V" + 转字符串(id) + " = cvi((long long)_i);\n")
        解析块()
        若 词值() == "结束"
            前进()
        结束
        发射("    }\n  }\n")
        期待换行()
        返回
    结束
    若 k == "返回"
        前进()
        字符串 v = emit_or()
        若 g在函数 == 假
            报错("返回 只能出现在函数内")
            返回
        结束
        发射("  return " + v + ";\n")
        期待换行()
        返回
    结束
    若 k == "函数"
        前进()
        字符串 函数名 = 词值()
        前进()
        期待("(")
        期待(")")
        若 词值() == "->"
            前进()
            前进()          # 跳过返回类型
        结束
        整数 函数号 = g函数N
        g函数N = g函数N + 1
        追加(g函数表, [函数名, 函数号])
        g在函数 = 真
        发射("\nstatic CoVal f_" + 转字符串(函数号) + "(void){\n")
        解析块()
        若 词值() == "结束"
            前进()
        结束
        发射("  return cvnull();\n}\n")
        g在函数 = 假
        期待换行()
        返回
    结束
    若 词类() == "标识符"
        字符串 名 = 词值()
        前进()
        若 词值() != "="
            报错("变量 '" + 名 + "' 后应为 '=' ")
        结束
        前进()
        字符串 v = emit_or()
        整数 id = varid(名)
        若 id == -1
            报错("内部错误：变量未登记 '" + 名 + "'")
        结束
        发射("  V" + 转字符串(id) + " = " + v + ";\n")
        期待换行()
        返回
    结束
    报错("意外的语句 '" + k + "'")
结束

# ---------- 主流程 ----------
函数 主流程()
    若 非 文件存在("自举输入.co")
        输出错误("自举编译器: 未找到输入源码 自举输入.co")
        断言(假, "缺少输入源码")
    结束
    g源 = 读文件("自举输入.co")
    g标记表 = 词法(g源)
    g名字表 = []
    g位置 = 0
    登记全部名字()
    g位置 = 0
    g临时N = 0
    g输出 = ""
    g函数代码 = ""            # 函数定义生成的 C（置于 main 之前）
    g函数表 = []
    g函数N = 0
    g在函数 = 假
    若 非 文件存在("自举运行时.c")
        输出错误("自举编译器: 缺少运行时模板 自举运行时.c")
        断言(假, "缺少运行时模板")
    结束
    字符串 模板 = 读文件("自举运行时.c")
    当 词值() != "EOF" 循环
        若 词值() == "NL"
            前进()
            继续
        结束
        解析语句()            # 函数定义进 g函数代码；其余进 main body
    结束
    整数 名数 = 长度(g名字表)
    字符串 声明 = ""
    对于 i 从 0 到 名数 - 1 循环
        声明 = 声明 + "  CoVal V" + 转字符串(i) + " = cvi(0);\n"
    结束
    写文件("自举产物.c", 模板 + g函数代码 + "\nint main(void){\n" + 声明 + g输出 + "  return 0;\n}\n")
    整数 rc = 执行命令("cc -O2 -Wall -Wextra 自举产物.c -o 自举输出 -lm")
    若 rc != 0
        输出错误("自举编译器: 调用 cc 失败（退出码 " + 转字符串(rc) + "）")
        断言(假, "调用 cc 失败")
    结束
    输出 "已编译：自举输出（由 coCN 写的编译器产出）"
结束

主流程()