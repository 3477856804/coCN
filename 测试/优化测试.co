# ============================================================
# 优化器与模型序列化测试：动量 SGD / Adam / 梯度裁剪 / L1 损失 / 保存与加载
# ============================================================

函数 接近(浮点 甲, 浮点 乙) -> 布尔
    返回 绝对值(甲 - 乙) < 0.01
结束

让 三 = 张量([3.0])

# ---------- 1) 动量 SGD：y=(w-3)^2 收敛到 3 ----------
让 w = 需梯度(张量([10.0]))
对于 i 从 0 到 300 循环
    反向((w - 三) * (w - 三))
    动量优化(0.02, 0.9, [w])
结束
断言(接近(取(w, 0), 3.0), "动量SGD未收敛到3")

# 动量系数超界必须报错（错误用例单测覆盖，这里只验证合法路径）
让 w2 = 需梯度(张量([1.0]))
反向((w2 - 三) * (w2 - 三))
动量优化(0.01, 0.5, [w2])
断言(取(w2, 0) > 1.0, "动量SGD应朝目标(3)移动")

# ---------- 2) Adam：收敛 + 不依赖学习率缩放，且能自定义超参 ----------
让 a = 需梯度(张量([-10.0]))
对于 i 从 0 到 2500 循环
    反向((a - 三) * (a - 三))
    Adam(0.05, [a])
结束
断言(接近(取(a, 0), 3.0), "Adam默认超参未收敛到3")

让 b = 需梯度(张量([20.0]))
对于 i 从 0 到 2500 循环
    反向((b - 三) * (b - 三))
    Adam(0.1, [b], 0.9, 0.99, 1e-8)
结束
断言(接近(取(b, 0), 3.0), "Adam自定义超参未收敛")

# ---------- 3) L1 平均绝对误差 ----------
让 p = 张量([1.0, 2.0, 3.0, 4.0])
让 t = 张量([1.0, 2.0, 5.0, 8.0])
断言(接近(取(平均绝对误差(p, t), 0), 1.5), "MAE计算错误")

# ---------- 4) 梯度裁剪：大梯度限幅后步长有界 ----------
让 大 = 需梯度(张量([100.0, -200.0, 300.0]))
反向(大 * 大)          # 梯度 = [200,-400,600]
裁剪梯度(2.0, [大])
优化(1.0, [大])       # data -> [98,-198,298]
断言(接近(取(大, 0), 98.0), "梯度裁剪上限失效")
断言(接近(取(大, 1), -198.0), "梯度裁剪下限失效")
断言(接近(取(大, 2), 298.0), "梯度裁剪上限失效(正侧)")

# ---------- 5) 模型保存 / 加载 round-trip ----------
让 w1 = 需梯度(随机张量([2, 3], 0, 1))
让 b1 = 需梯度(全零([3]))
让 w2 = 需梯度(高斯随机([3, 1], 0, 1))
保存模型("/tmp/co模型.bin", [w1, b1, w2])
让 新w1 = 张量([[0, 0, 0], [0, 0, 0]])
让 新b1 = 张量([0, 0, 0])
让 新w2 = 张量([[0], [0], [0]])
加载模型("/tmp/co模型.bin", [新w1, 新b1, 新w2])
对于 r 从 0 到 1 循环
    对于 c 从 0 到 2 循环
        断言(接近(取(新w1, r, c), 取(w1, r, c)), "w1保存/加载不匹配")
    结束
结束
对于 i 从 0 到 2 循环
    断言(接近(取(新b1, i), 取(b1, i)), "b1保存/加载不匹配")
    断言(接近(取(新w2, i, 0), 取(w2, i, 0)), "w2保存/加载不匹配")
结束

# 保存的一维/二维/标量张量均能精确往返，且删除文件可清理

删除文件("/tmp/co模型.bin")
输出 "优化测试：全部通过"