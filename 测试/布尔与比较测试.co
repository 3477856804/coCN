# ============================================================
# 布尔与比较回归测试
# 覆盖历史上真实存在过的严重缺陷，任何一条失败都说明语义退化：
#   1) "abc" == "xyz" 曾被当成字符串拼接 → 恒为真（测试假绿的元凶）
#   2) [1,2] == [1,2] 曾误读联合体 → 恒为假
#   3) 真 曾是整数 1 的别名 → 打印成 1、类型不可辨
#   4) y = -x 曾原地取负 → 把 x 本身改成 -5
#   5) 等待 甲 + 等待 乙 曾把整个加法当成等待的操作数
# ============================================================

# ---------- 布尔是一等类型 ----------
断言相等(类型(真), "布尔", "真的类型是布尔")
断言相等(类型(假), "布尔", "假的类型是布尔")
断言相等(转字符串(真), "真", "真打印为真")
断言相等(转字符串(假), "假", "假打印为假")
断言相等(类型(1 < 2), "布尔", "比较结果是布尔")
断言相等(类型(1 == 1), "布尔", "相等结果是布尔")
断言相等(类型(真 且 假), "布尔", "逻辑与结果是布尔")
断言相等(类型(非 真), "布尔", "逻辑非结果是布尔")
断言相等(转字符串(1 > 2), "假", "假比较打印为假")

# 布尔与整数互操作（真=1 假=0），保证与既有数值代码兼容
断言(真 == 1, "真等于1")
断言(假 == 0, "假等于0")
断言相等(真 + 真, 2, "布尔可参与算术")
断言相等(转整数(真), 1, "转整数(真)=1")
断言相等(转浮点(假), 0.0, "转浮点(假)=0")
断言相等(转布尔(0), 假, "转布尔(0)=假")
断言相等(转布尔("x"), 真, "转布尔(非空串)=真")
断言相等(转布尔([]), 假, "转布尔(空列表)=假")

# 布尔类型标注只接受布尔
布尔 开关 = 真
断言(开关, "布尔标注可赋真")
断言相等(类型(开关), "布尔", "布尔变量保持布尔类型")

# ---------- 字符串比较（历史重大缺陷） ----------
断言(("abc" == "abc") == 真, "相同字符串相等")
断言(("abc" == "xyz") == 假, "不同字符串【不】相等")
断言(("abc" != "xyz") == 真, "不同字符串不等为真")
断言(("abc" != "abc") == 假, "相同字符串不等为假")
断言("apple" < "banana", "字符串小于")
断言("banana" > "apple", "字符串大于")
断言("abc" <= "abc", "字符串小于等于")
断言("abc" >= "abc", "字符串大于等于")
断言(("中文" == "中文") == 真, "中文字符串相等")
断言(("中文" == "英文") == 假, "不同中文字符串不等")
断言相等(类型("a" == "a"), "布尔", "字符串比较返回布尔而非拼接结果")

# 字符串只允许 + 拼接（其余运算符必须报错，见 测试/错误用例/）
断言相等("abc" + "def", "abcdef", "字符串拼接")
断言相等("值=" + 42, "值=42", "字符串拼数字")
断言相等("开关=" + 真, "开关=真", "字符串拼布尔显示真")
断言相等("表=" + [1, 2], "表=[1, 2]", "字符串拼列表")

# ---------- 容器结构化比较（历史重大缺陷） ----------
断言(([1, 2, 3] == [1, 2, 3]) == 真, "同构列表相等")
断言(([1, 2, 3] == [1, 2, 4]) == 假, "不同列表不等")
断言(([1, 2] == [1, 2, 3]) == 假, "长度不同的列表不等")
断言(([[1, 2], [3]] == [[1, 2], [3]]) == 真, "嵌套列表相等")
断言(([1, 2] != [2, 1]) == 真, "顺序不同的列表不等")
断言([1, 2] < [1, 3], "列表字典序比较")
断言([1, 2] < [1, 2, 0], "较短的前缀列表更小")
断言(({"甲": 1, "乙": 2} == {"乙": 2, "甲": 1}) == 真, "字典相等与键顺序无关")
断言(({"甲": 1} == {"甲": 2}) == 假, "字典值不同则不等")
断言(({"甲": 1} == {"甲": 1, "乙": 2}) == 假, "字典大小不同则不等")
断言相等([1, 2] + [3], [1, 2, 3], "列表加法为拼接")

# 断言相等 也必须能结构化判等
断言相等([1, [2, 3]], [1, [2, 3]], "断言相等支持嵌套列表")
断言相等({"a": [1, 2]}, {"a": [1, 2]}, "断言相等支持字典")

# ---------- 一元运算不得污染源值（历史重大缺陷） ----------
整数 原值 = 5
整数 取负 = -原值
断言相等(原值, 5, "取负后原变量不被篡改")
断言相等(取负, -5, "取负结果正确")

列表 源表 = [1, 2, 3]
整数 首负 = -源表[0]
断言相等(源表, [1, 2, 3], "对元素取负后列表不被篡改")
断言相等(首负, -1, "元素取负结果正确")

浮点 浮值 = 2.5
浮点 浮负 = -浮值
断言相等(浮值, 2.5, "浮点取负后原变量不被篡改")
断言相等(浮负, -2.5, "浮点取负结果正确")

字典 源典 = {"k": 7}
整数 键负 = -源典["k"]
断言相等(源典["k"], 7, "对字典值取负后字典不被篡改")
断言相等(键负, -7, "字典值取负结果正确")

# 连续取负
断言相等(-(-原值), 5, "双重取负还原")

# ---------- 真值规则 ----------
断言(转布尔([]) == 假, "空列表为假")
断言(转布尔([0]) == 真, "非空列表为真")
断言(转布尔({}) == 假, "空字典为假")
断言(转布尔({"a": 1}) == 真, "非空字典为真")
断言(转布尔("") == 假, "空字符串为假")
断言(转布尔(0.0) == 假, "0.0为假")

整数 计数 = 0
若 [] 那么
    计数 = 计数 + 1
结束
若 [1] 那么
    计数 = 计数 + 10
结束
断言相等(计数, 10, "空容器在条件中为假、非空为真")

# ---------- 逻辑运算与短路 ----------
断言相等(真 且 真, 真, "与：真真")
断言相等(真 且 假, 假, "与：真假")
断言相等(假 或 真, 真, "或：假真")
断言相等(假 或 假, 假, "或：假假")
断言相等(非 假, 真, "非假为真")
断言相等(非 非 真, 真, "双重非")
断言相等(非 [], 真, "非空列表为真")

整数 副作用 = 0
函数 记录() -> 布尔
    副作用 = 副作用 + 1
    返回 真
结束
若 假 且 记录() 那么
    计数 = 计数 + 1
结束
断言相等(副作用, 0, "与运算短路：右侧不求值")
若 真 或 记录() 那么
    计数 = 计数
结束
断言相等(副作用, 0, "或运算短路：右侧不求值")

# ---------- 谓词类内置函数返回布尔 ----------
断言相等(类型(包含([1, 2], 1)), "布尔", "包含返回布尔")
断言相等(包含([1, 2, 3], 2), 真, "列表包含元素")
断言相等(包含([1, 2, 3], 9), 假, "列表不含元素")
断言相等(包含([[1], [2]], [2]), 真, "包含支持嵌套列表判等")
断言相等(包含("你好世界", "世界"), 真, "字符串包含子串")
断言相等(包含({"甲": 1}, "甲"), 真, "字典包含键")
断言相等(包含({"甲": 1}, "乙"), 假, "字典不含键")
断言相等(类型(开头是("abc", "a")), "布尔", "开头是返回布尔")
断言相等(开头是("你好世界", "你好"), 真, "开头是")
断言相等(结尾是("你好世界", "世界"), 真, "结尾是")
断言相等(结尾是("你好世界", "你好"), 假, "结尾不是")

函数 是正数(整数 x) -> 布尔
    返回 x > 0
结束
断言相等(类型(全部满足([1, 2], 是正数)), "布尔", "全部满足返回布尔")
断言相等(全部满足([1, 2, 3], 是正数), 真, "全部为正")
断言相等(全部满足([1, -2, 3], 是正数), 假, "存在非正")
断言相等(任一满足([-1, 2], 是正数), 真, "任一为正")
断言相等(任一满足([-1, -2], 是正数), 假, "全都非正")

# ---------- 布尔作为排序/条件的标志位 ----------
断言相等(排序([3, 1, 2], 真), [3, 2, 1], "布尔真触发降序")
断言相等(排序([3, 1, 2], 假), [1, 2, 3], "布尔假保持升序")
断言相等(排序([3, 1, 2]), [1, 2, 3], "默认升序")

# ---------- 布尔进容器与推导式 ----------
列表 标志表 = [真, 假, 真]
断言相等(转字符串(标志表), "[真, 假, 真]", "布尔在列表中正确显示")
断言相等(长度(过滤([1, 2, 3, 4], 是正数)), 4, "布尔谓词驱动过滤")
列表 判定表 = [x > 2 对于 x 在 [1, 2, 3, 4]]
断言相等(转字符串(判定表), "[假, 假, 真, 真]", "推导式产出布尔列表")
断言相等(长度([x 对于 x 在 范围(1, 11) 如果 x % 2 == 0]), 5, "布尔条件驱动推导式过滤")

# ---------- 模式匹配上的布尔 ----------
布尔 状态 = 真
字符串 描述 = ""
匹配 状态
    情况 真: 描述 = "开"
    情况 假: 描述 = "关"
结束
断言相等(描述, "开", "布尔参与模式匹配")

输出 "布尔与比较测试：全部通过"
