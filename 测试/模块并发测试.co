# ============================================================
# 模块与并发测试
# ============================================================

导入 "标准库"

# ---------- 模块函数可用 ----------
断言相等(平方(4), 16, "模块函数：平方")
断言相等(立方(3), 27, "模块函数：立方")
断言(绝对值(安全比值(1, 2) - 0.5) < 0.000001, "模块函数：安全比值")
断言相等(安全比值(10, 3), 1, "安全比值上限截断")
断言相等(安全比值(1, 0), 0, "安全比值除零保护")

# ---------- 函数提升：主流程写在前，工具函数写在后 ----------
断言相等(先用后定义(6), 36, "顶层函数提升：先调用后定义")

函数 先用后定义(整数 x) -> 整数
    返回 辅助(x) * 辅助(x)
结束

函数 辅助(整数 x) -> 整数
    返回 x
结束

# ---------- 并发：并发 / 等待 ----------
函数 慢加(整数 n) -> 整数
    整数 s = 0
    对于 i 从 1 到 n 循环
        s = s + i
    结束
    返回 s
结束

任务1 = 并发 慢加(1000)
任务2 = 并发 慢加(2000)
整数 r1 = 等待 任务1
整数 r2 = 等待 任务2
断言相等(r1, 500500, "并发任务1结果")
断言相等(r2, 2001000, "并发任务2结果")
断言相等(r1 + r2, 2501500, "两个并发任务结果之和")

# 并发返回字符串
函数 拼(字符串 a) -> 字符串
    返回 a + "-完成"
结束
任务3 = 并发 拼("甲")
断言相等(等待 任务3, "甲-完成", "并发返回字符串")

# 并发返回列表
函数 造表(整数 n)
    返回 范围(1, n + 1)
结束
任务4 = 并发 造表(5)
列表 得表 = 等待 任务4
断言相等(长度(得表), 5, "并发返回列表长度")
断言相等(累加(得表), 15, "并发返回列表内容")

# 多任务批量并发（验证线程局部状态不互相踩踏）
任务A = 并发 慢加(100)
任务B = 并发 慢加(200)
任务C = 并发 慢加(300)
任务D = 并发 慢加(400)
整数 总 = 等待 任务A + 等待 任务B + 等待 任务C + 等待 任务D
断言相等(总, 5050 + 20100 + 45150 + 80200, "四任务并发结果全部正确")

输出 "模块并发测试：全部通过"
