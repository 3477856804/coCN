# 新函数冒烟测试：格式化 / 环境变量 / 时钟毫秒 / 复制 / 合并字典 / 等待毫秒 / 退出
断言相等(格式化("用户: {}, 年龄: {}", "小明", 18), "用户: 小明, 年龄: 18")
断言相等(格式化("{}+{}={}", 1, 2, 3), "1+2=3")
断言相等(格式化("纯文本"), "纯文本")

设置环境变量("COCN_TEST_VAR", "中文值")
断言相等(环境变量("COCN_TEST_VAR"), "中文值")
断言(长度(环境变量("PATH")) > 0, "PATH 应存在")

让 t1 = 时钟毫秒()
等待毫秒(5)
让 t2 = 时钟毫秒()
断言(t2 - t1 >= 5, "等待毫秒至少等待 5ms")

# 复制：字符串独立副本
让 s = "你好"
让 s2 = 复制(s)
s2 = s2 + "！"
断言相等(s, "你好")
断言相等(s2, "你好！")

# 复制：列表浅拷贝
让 甲 = [1, 2, 3]
让 乙 = 复制(甲)
追加(乙, 4)
断言相等(甲, [1, 2, 3])
断言相等(乙, [1, 2, 3, 4])

# 复制：字典浅拷贝
让 源 = {"a": 1, "b": 2}
让 副本 = 复制(源)
断言相等(副本["a"], 1)
移除键(副本, "a")
断言(包含(源, "a"), "源字典不受副本影响")

# 合并字典：覆盖同名键
让 目标 = {"x": 1, "y": 2}
让 增补 = {"y": 9, "z": 3}
让 合并结果 = 合并字典(目标, 增补)
断言(合并结果 == 目标, "合并字典返回目标本身")
断言相等(目标["x"], 1)
断言相等(目标["y"], 9)
断言相等(目标["z"], 3)
断言相等(长度(目标), 3)

# 复制：张量深拷贝
让 张 = 张量([[1.0, 2.0], [3.0, 4.0]])
让 张2 = 复制(张)
置(张2, 0, 0, 99.0)
断言相等(取(张, 0, 0), 1.0)
断言相等(取(张2, 0, 0), 99.0)

# /tmp 映射：写读删往返（Windows 上也应可用）
写文件("/tmp/co冒烟.txt", "临时内容")
断言(文件存在("/tmp/co冒烟.txt"), "写 /tmp 后文件应存在")
断言相等(读文件("/tmp/co冒烟.txt"), "临时内容")
追加文件("/tmp/co冒烟.txt", "追加段")
断言相等(读文件("/tmp/co冒烟.txt"), "临时内容追加段")
断言(删除文件("/tmp/co冒烟.txt"), "删除 /tmp 文件应成功")

输出 "系统函数冒烟：全部通过"
