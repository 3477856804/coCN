# 原生通道回归：多层嵌套循环 + 跳出/继续的作用域、长 否则若 链

# ---- 二重循环 + 内层跳出（只能跳内层）----
整数 计数 = 0
对于 i 从 1 到 3 循环
    对于 j 从 1 到 3 循环
        如果 j == 2 则 跳出 结束
        计数 = 计数 + 1
        输出("格子:", i, j)
    结束
结束
断言相等(计数, 3, "内层跳出只影响内层")

# ---- 二重循环 + 内层继续 ----
整数 和 = 0
对于 i 从 1 到 3 循环
    对于 j 从 1 到 3 循环
        如果 j == 2 则 继续 结束
        和 = 和 + j
    结束
结束
断言相等(和, 12, "跳过 j==2：每轮 1+3=4，三轮共 12")

# ---- 当 循环里嵌 对于 循环 ----
整数 k = 0
整数 累计 = 0
当 k < 3 循环
    k = k + 1
    对于 m 从 0 到 1 循环
        累计 = 累计 + 1
    结束
结束
断言相等(累计, 6, "3 轮 x 每轮 2 次")

# ---- 长 否则若 链：必须恰好走一条分支 ----
函数 评级(分)
    如果 分 >= 95 则
        返回 "S"
    否则若 分 >= 90 则
        返回 "A"
    否则若 分 >= 80 则
        返回 "B"
    否则若 分 >= 70 则
        返回 "C"
    否则若 分 >= 60 则
        返回 "D"
    否则
        返回 "F"
    结束
结束
对于 分 从 55 到 100 步长 5 循环
    输出("评级", 分, "->", 评级(分))
结束
断言相等(评级(100), "S", "满分")
断言相等(评级(95), "S", "S 下界")
断言相等(评级(94), "A", "A 上界")
断言相等(评级(59), "F", "不及格")

# ---- 循环体内声明变量（每轮重新赋值）----
对于 t 从 0 到 2 循环
    整数 临时 = t * 10
    输出("循环内变量:", 临时)
结束

# ---- 条件里带函数调用 + 短路 ----
函数 是正(v)
    返回 v > 0
结束
整数 x = 5
如果 是正(x) 且 x < 10 则
    输出("x 在 (0,10) 内")
否则
    输出("x 不在范围内")
结束

# ---- 跳出在 当 循环中提前终止 ----
整数 n = 0
当 真 循环
    n = n + 1
    如果 n >= 5 则 跳出 结束
结束
断言相等(n, 5, "无限循环靠跳出终止")

输出("嵌套控制流：全部通过")
