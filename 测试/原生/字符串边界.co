# 原生通道回归：UTF-8 字符坐标 vs 字节坐标、空串、越界钳制

字符串 混合 = "abc汉字xyz"

# ---- 字符长度 vs 字节长度 ----
断言相等(长度(混合), 8, "a b c 汉 字 x y z 共 8 个字符")
断言相等(字节数(混合), 12, "汉字各占 3 字节：6+6=12")
输出("长度/字节数:", 长度(混合), 字节数(混合))

# ---- 下标按字符（正负都要对）----
输出("正下标:", 混合[0], 混合[3], 混合[4], 混合[7])
输出("负下标:", 混合[-1], 混合[-6])
断言相等(混合[3], "汉", "第 4 个字符是汉")
断言相等(混合[-1], "z", "最后一个字符")

# ---- 字节视图（正负下标）----
输出("字节:", 字节(混合, 0), 字节(混合, 3), 字节(混合, -1))
断言相等(字节(混合, 0), 97, "'a' 的字节值")
断言相等(字节(混合, -1), 122, "'z' 的字节值")

# ---- 截取：字符坐标 + 越界钳制（不报错，按语言约定截到边界）----
断言相等(截取(混合, 0, 3), "abc", "取前三")
断言相等(截取(混合, 3, 2), "汉字", "跨汉字截取")
断言相等(截取(混合, -3, 3), "xyz", "负起点")
断言相等(截取(混合, 0, 999), 混合, "长度超限被钳制")
断言相等(截取(混合, 999, 3), "", "起点超限得空串")
断言相等(截取(混合, 0, 0), "", "零长度")
输出("截取:", 截取(混合, 0, 3), 截取(混合, 3, 2), 截取(混合, -3, 3))

# ---- 查找：返回字符下标，不是字节偏移 ----
断言相等(查找(混合, "汉"), 3, "汉在字符下标 3")
断言相等(查找(混合, "xyz"), 5, "xyz 在字符下标 5")
断言相等(查找(混合, "没有"), -1, "找不到返回 -1")
输出("查找:", 查找(混合, "汉"), 查找(混合, "xyz"), 查找(混合, "没有"))

# ---- 码点往返 ----
断言相等(字符码("汉"), 27721, "汉的码点")
断言相等(码转字符(27721), "汉", "码点转回汉")
断言相等(字符码(混合, 3), 27721, "带下标取码点")
断言相等(码转字符(65), "A", "ASCII 往返")
输出("码点:", 字符码("汉"), 码转字符(27721))

# ---- 空串行为 ----
字符串 空串 = ""
断言相等(长度(空串), 0, "空串长度 0")
断言相等(字节数(空串), 0, "空串字节 0")
断言相等(空串 + "a", "a", "空串拼接")
断言相等(重复("x", 0), "", "重复 0 次")
断言相等(去空白("   "), "", "全空白去掉后为空")
断言(非 开头是(空串, "a"), "空串没有前缀 a")
断言(开头是(空串, ""), "任何串都有空前缀")

# ---- 大小写只动 ASCII，不破坏 UTF-8 ----
断言相等(大写("abc汉字"), "ABC汉字", "汉字不受影响")
断言相等(小写("ABC汉字"), "abc汉字", "汉字不受影响")

# ---- 替换：等长/变长/多次 ----
断言相等(替换("aaa", "a", "b"), "bbb", "等长多次")
断言相等(替换("aaa", "a", "xx"), "xxxxxx", "变长扩张")
断言相等(替换("aaa", "aa", ""), "a", "删除并留余")
断言相等(替换("汉字汉字", "汉", "H"), "H字H字", "UTF-8 替换")
输出("替换:", 替换("aaa", "a", "xx"), 替换("汉字汉字", "汉", "H"))

# ---- 去空白三兄弟 ----
断言相等(去空白("\t hi \n"), "hi", "两侧都去")
断言相等(去左空白("  hi  "), "hi  ", "只去左")
断言相等(去右空白("  hi  "), "  hi", "只去右")

# ---- 数字转字符串的格式必须与 输出 一致 ----
断言相等(转字符串(1), "1", "整数")
断言相等(转字符串(1.5), "1.5", "浮点")
断言相等(转字符串(1.0), "1", "整值浮点按 %g 打印为 1")
断言相等(转字符串(真), "真", "布尔真")
断言相等(转字符串(假), "假", "布尔假")

输出("字符串边界：全部通过")
