# 作用域与全局可变状态
#
# 这个文件守护一个曾经存在的严重缺陷：
#   赋值语句原先用 env_set（只看当前作用域，找不到就新建），
#   于是函数体里的 `计数 = 计数 + 1` 会在函数局部新建一个 `计数` 遮蔽全局，
#   读到全局旧值、写进局部副本，函数返回后修改蒸发。
#   表现是「不报错、能跑、结果错」——每次调用都返回 1，全局永远是 0。
#   计数器 / 累加器 / 缓存 / 分配器全都依赖全局可变状态，这条错了，系统级代码就没法写。
#
# 修法是引入 env_assign 沿作用域链更新已有绑定。
# 但修完必须反向验证：遮蔽语义（局部声明、形参、循环变量）绝不能被顺带破坏。

# ---- 1. 函数必须能真正修改全局 ----
整数 计数 = 0
函数 递增()
    计数 = 计数 + 1
    返回 计数
结束
断言相等(递增(), 1, "第1次调用应返回1")
断言相等(递增(), 2, "第2次调用应返回2（全局必须真的被写回）")
断言相等(递增(), 3, "第3次调用应返回3")
断言相等(计数, 3, "全局计数必须累加到3")

# ---- 2. 局部声明必须遮蔽同名全局 ----
整数 v = 100
函数 用局部()
    整数 v = 5
    v = v + 1
    返回 v
结束
断言相等(用局部(), 6, "局部变量应独立计算")
断言相等(v, 100, "局部声明不得污染同名全局")

# ---- 3. 形参必须遮蔽同名全局 ----
整数 p = 100
函数 用参数(p)
    p = p * 2
    返回 p
结束
断言相等(用参数(7), 14, "形参应独立")
断言相等(p, 100, "形参不得污染同名全局")

# ---- 4. 递归：每层局部互不干扰，同时全局能跨层累加 ----
整数 调用次数 = 0
函数 递归求和(n)
    调用次数 = 调用次数 + 1
    如果 n <= 0 则 返回 0 结束
    整数 本层 = n
    整数 子 = 递归求和(n - 1)
    断言相等(本层, n, "本层局部变量不得被子调用改写")
    返回 本层 + 子
结束
断言相等(递归求和(10), 55, "递归求和应为55")
断言相等(调用次数, 11, "全局计数应跨11层递归累加")

# ---- 5. 跨函数共享全局：一个写、一个读 ----
整数 共享 = 0
函数 写共享()
    共享 = 777
结束
函数 读共享()
    返回 共享
结束
写共享()
断言相等(读共享(), 777, "一个函数写的全局，另一个函数必须读到")

# ---- 6. 自赋值不得触发释放后使用（先 retain 新值再 free 旧值）----
整数 自 = 42
自 = 自
断言相等(自, 42, "整数自赋值应保持原值")
字符串 s = "保持不变"
s = s
断言相等(s, "保持不变", "字符串自赋值不得读到已释放内存")

# ---- 7. 全局累加器：典型的「必须有全局可变状态」场景 ----
整数 总和 = 0
函数 累加(x)
    总和 = 总和 + x
    返回 总和
结束
整数 i = 1
当 i <= 10 循环
    累加(i)
    i = i + 1
结束
断言相等(总和, 55, "全局累加器应得到55")

# ---- 8. 空值字面量：能打印就必须能写出来（round-trip 自洽）----
断言相等(转字符串(空), "空", "空的字符串形式应为「空」")
断言相等(类型(空), "空", "空的类型名应为「空」")
断言相等(转布尔(空), 假, "空应为假值")
断言(空 == 空, "空应等于空")
断言(空 != 0, "空不应等于0")
断言(非 空, "非空应为真")
空 未设 = 空
断言相等(转字符串(未设), "空", "空类型变量应保持为空")

# ---- 9. 全局标志位：布尔全局也必须可写 ----
布尔 已初始化 = 假
函数 初始化()
    如果 已初始化 则 返回 假 结束
    已初始化 = 真
    返回 真
结束
断言(初始化(), "首次初始化应返回真")
断言相等(初始化(), 假, "重复初始化应返回假（幂等保护依赖全局标志）")
断言(已初始化, "全局标志应已被置真")

输出("作用域与全局：全部通过")
