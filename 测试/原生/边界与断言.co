# 原生通道回归：断言、数值边界、浮点打印格式、嵌套短路、深递归
# 断言全部通过才算过；任何一条不成立都会以非零退出。

# ---- 断言本身 ----
断言(真, "真值应通过")
断言(1, "非零整数为真")
断言("x", "非空串为真")
断言相等(1 + 1, 2, "整数加法")
断言相等(0.5 + 0.5, 1.0, "浮点加法")
断言相等("a" + "b", "ab", "字符串拼接")

# ---- 整数边界（64 位）----
整数 最大 = 9223372036854775807
输出("最大整数:", 最大)
输出("最小整数:", -9223372036854775807 - 1)

# ---- 浮点打印：%g 语义（与解释器必须一致）----
输出("浮点格式:", 1.0, 0.5, 100.0, 1e10, 0.0001, 1.0 / 3.0)
输出("整浮混算:", 1 + 0.5, 3 * 1.5, 10 / 4, 10 // 4, 7 % 2.5)

# ---- 类型提升：整数运算保持整数，含浮点则升浮点 ----
断言相等(类型(1 + 1), "整数", "整数+整数=整数")
断言相等(类型(1 + 1.0), "浮点", "整数+浮点=浮点")
断言相等(类型(4 / 2), "浮点", "真除恒为浮点")
断言相等(类型(4 // 2), "整数", "整除恒为整数")

# ---- 布尔是一等类型，不是整数别名 ----
断言相等(类型(真), "布尔", "真的类型")
断言相等(类型(1 > 0), "布尔", "比较结果是布尔")
输出("布尔打印:", 真, 假, 1 > 0, 1 < 0)

# ---- 嵌套短路：内层除零绝不能被求值 ----
布尔 r1 = 假 且 (真 或 (1 / 0 > 0))
布尔 r2 = 真 或 (假 且 (1 / 0 > 0))
布尔 r3 = (真 且 真) 且 (真 或 假)
输出("嵌套短路:", r1, r2, r3)
断言(非 r1, "r1 必须为假")
断言(r2, "r2 必须为真")
断言(r3, "r3 必须为真")

# ---- 深递归：验证原生栈与返回值清理 ----
函数 累加到(n)
    如果 n <= 0 则 返回 0 结束
    返回 n + 累加到(n - 1)
结束
断言相等(累加到(1000), 500500, "1..1000 求和")
输出("累加到(1000):", 累加到(1000))

# ---- 位运算边界 ----
输出("移位边界:", 1 << 62, -1 >> 63, 0 << 63)
断言相等(1 << 10, 1024, "左移")
断言相等(-8 >> 1, -4, "负数算术右移")
断言相等(~0, -1, "按位取反")
断言相等(位计数(-1), 64, "全1的位数")

输出("边界与断言：全部通过")
