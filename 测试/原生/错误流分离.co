# 错误流分离：输出 -> stdout，输出错误 -> stderr
#
# 为什么这条要单独立一个用例：
#   系统编程里「数据」和「诊断」必须分流，否则 `co 程序 | 下游工具` 会被日志污染。
#   而且解释器和原生产物必须在【两条流上都】逐字节一致——只对齐 stdout 是不够的。
#
# 注意：本文件最后一行必须是 stdout 的「全部通过」。
# 因为 stderr 无缓冲、stdout 重定向到文件时是块缓冲，2>&1 合并后 stderr 会先出现，
# 所以 tail -1 拿到的是最后一条 stdout 行。

输出("数据: 开始")
输出错误("诊断: 开始")

# 多参数、混合类型，与 输出 的格式规则必须完全一致（空格分隔 + 末尾换行）
输出("数据:", 1, 2.5, 真, 假, 空)
输出错误("诊断:", 1, 2.5, 真, 假, 空)

# 零参数：只产生一个空行
输出()
输出错误()

# 表达式求值发生在写流之前，两条流的求值顺序都不能变
整数 计数 = 0
函数 递增()
    计数 = 计数 + 1
    返回 计数
结束
输出("数据/求值:", 递增(), 递增())
输出错误("诊断/求值:", 递增(), 递增())
断言相等(计数, 4, "输出与输出错误都应正常求值实参")

# 字符串拼接与转义在两条流上表现一致
字符串 名 = "coCN"
输出("数据/拼接: " + 名 + "!")
输出错误("诊断/拼接: " + 名 + "!")

# 循环里交替写两条流，验证不会互相串写（各自独立的缓冲策略）
整数 i = 0
当 i < 3 循环
    输出("数据/轮次", i)
    输出错误("诊断/轮次", i)
    i = i + 1
结束

# 诊断信息里带数值：常见的「进度/统计」用法
输出错误("诊断/统计: 处理", 3, "条，失败", 0, "条")

输出("全部通过")
