# 原生双通道用例：只使用原生后端支持的函数子集（标量/字符串/列表/文件）
# 系统函数（原生通道也须可用）：格式化 / 环境变量 / 设置环境变量 / 时钟毫秒 / 复制 / 等待毫秒
断言相等(格式化("用户: {}, 年龄: {}", "小明", 18), "用户: 小明, 年龄: 18")
断言相等(格式化("{}+{}={}", 1, 2, 3), "1+2=3")

设置环境变量("COCN_TEST_VAR", "中文值")
断言相等(环境变量("COCN_TEST_VAR"), "中文值")

让 t1 = 时钟毫秒()
等待毫秒(2)
让 t2 = 时钟毫秒()
断言(t2 - t1 >= 2, "等待毫秒至少等待 2ms")

# 复制：字符串独立副本
让 s = "你好"
让 s2 = 复制(s)
s2 = s2 + "！"
断言相等(s, "你好")
断言相等(s2, "你好！")

# 复制：列表浅拷贝
让 甲 = [1, 2, 3]
让 乙 = 复制(甲)
追加(乙, 4)
断言相等(甲, [1, 2, 3])
断言相等(乙, [1, 2, 3, 4])

# 复制：数字
让 n = 42
断言相等(复制(n), 42)

# /tmp 映射（原生通道同样应可用）
写文件("/tmp/co原生临时.txt", "原生临时")
断言(文件存在("/tmp/co原生临时.txt"), "原生写 /tmp 后文件应存在")
断言相等(读文件("/tmp/co原生临时.txt"), "原生临时")
断言(删除文件("/tmp/co原生临时.txt"), "原生删除 /tmp 文件应成功")

输出 "系统函数原生：全部通过"
