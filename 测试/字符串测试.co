# ============================================================
# 字符串测试：UTF-8 字符语义（中文编程语言的底线要求）
# 一切长度/下标/截取/查找都以【字符】为单位，绝不切碎汉字
# ============================================================

# --- 长度按字符计算，不是字节 ---
断言相等(长度("苹果"), 2, "两个汉字长度应为 2")
断言相等(长度("hello"), 5, "ASCII 长度")
断言相等(长度("中a文b"), 4, "中英混排长度")
断言相等(长度(""), 0, "空串长度")
断言相等(长度("😀😀"), 2, "四字节 emoji 长度")

# --- 下标取出完整字符 ---
断言相等("苹果"[0], "苹", "首字符")
断言相等("苹果"[1], "果", "次字符")
断言相等("中a文"[1], "a", "混排取 ASCII")
断言相等("你好世界"[-1], "界", "负索引取末字符")
断言相等("你好世界"[-4], "你", "负索引取首字符")

# --- 截取按字符，支持负起点 ---
断言相等(截取("中文编程语言", 2, 2), "编程", "中间截取")
断言相等(截取("中文编程语言", 0, 2), "中文", "开头截取")
断言相等(截取("中文编程语言", 4, 2), "语言", "结尾截取")
断言相等(截取("中文编程语言", -2, 2), "语言", "负起点截取")
断言相等(截取("中文编程", 0, 100), "中文编程", "长度超界自动裁剪")

# --- 查找返回字符下标 ---
断言相等(查找("中文编程", "编程"), 2, "查找返回字符位置")
断言相等(查找("中文编程", "中"), 0, "查找开头")
断言相等(查找("中文编程", "不存在"), -1, "查找失败返回 -1")

# --- 拼接与分割 ---
断言相等("中文" + "编程", "中文编程", "字符串拼接")
断言相等(长度(分割("甲,乙,丙", ",")), 3, "分割段数")
断言相等(分割("甲,乙,丙", ",")[1], "乙", "分割取段")
断言相等(连接(["甲", "乙"], "-"), "甲-乙", "连接列表")
断言相等(替换("中文编程", "编程", "语言"), "中文语言", "替换子串")
断言相等(包含("中文编程", "编程"), 1, "包含判断")

# --- 逐字符遍历（推导式）---
列表 字符表 = [c 对于 c 于 "苹果香蕉"]
断言相等(长度(字符表), 4, "按字符遍历个数")
断言相等(字符表[0], "苹", "遍历首字符")
断言相等(字符表[3], "蕉", "遍历末字符")

# --- 反转（依赖正确的字符下标）---
函数 反转(字符串 s) -> 字符串
    字符串 r = ""
    对于 i 从 长度(s) - 1 到 0 步长 -1 循环
        r = r + s[i]
    结束
    返回 r
结束
断言相等(反转("你好世界"), "界世好你", "中文反转")
断言相等(反转("abc"), "cba", "英文反转")

输出 "字符串测试：全部通过"
