# 性能基准：解释器通道 vs 原生编译通道
#
# 设计约束（很重要）：
#   1. 计算结果全部写 stdout —— 两条通道必须逐字节相同，否则「快」毫无意义。
#   2. 耗时全部写 stderr（输出错误）—— 耗时天然不可复现，绝不能污染可比对的 stdout。
#   这样 测试/基准运行.sh 就能一边 diff 结果、一边抽取耗时算加速比。
#
# 四个负载分别压不同的执行路径：
#   斐波那契 -> 函数调用 + 递归 + 栈帧管理
#   循环求和 -> 循环调度 + 变量读写 + 整数运算
#   素数计数 -> 嵌套循环 + 取模 + 分支
#   字符串搓 -> 字符串拼接/查找/截取（走 UTF-8 字符坐标路径）

函数 斐波那契(n)
    如果 n < 2 则 返回 n 结束
    返回 斐波那契(n - 1) + 斐波那契(n - 2)
结束

函数 循环求和(上限)
    整数 和 = 0
    整数 i = 0
    当 i < 上限 循环
        和 = 和 + i
        i = i + 1
    结束
    返回 和
结束

函数 素数个数(上限)
    整数 计数 = 0
    对于 n 从 2 到 上限 循环
        布尔 是素数 = 真
        整数 d = 2
        当 d * d <= n 循环
            如果 n % d == 0 则
                是素数 = 假
                跳出
            结束
            d = d + 1
        结束
        如果 是素数 则 计数 = 计数 + 1 结束
    结束
    返回 计数
结束

# 字符串负载：反复拼接再查找，最后返回一个可校验的整数指纹。
# 用整数当返回值而不是返回长字符串，是为了让 stdout 短小、diff 直观。
函数 字符串指纹(轮数)
    字符串 缓冲 = ""
    整数 指纹 = 0
    整数 i = 0
    当 i < 轮数 循环
        缓冲 = "键" + 转字符串(i % 97) + "=值;"
        指纹 = 指纹 + 长度(缓冲) + 查找(缓冲, "=")
        如果 开头是(缓冲, "键1") 则 指纹 = 指纹 + 1 结束
        i = i + 1
    结束
    返回 指纹
结束

浮点 t0 = 时钟()
整数 r1 = 斐波那契(27)
浮点 t1 = 时钟()
整数 r2 = 循环求和(2000000)
浮点 t2 = 时钟()
整数 r3 = 素数个数(60000)
浮点 t3 = 时钟()
整数 r4 = 字符串指纹(200000)
浮点 t4 = 时钟()

# ---- 结果：stdout，两条通道必须逐字节相同 ----
输出("斐波那契(27) =", r1)
输出("循环求和(200万) =", r2)
输出("素数个数(60000) =", r3)
输出("字符串指纹(20万) =", r4)

# ---- 耗时：stderr，不参与一致性比对 ----
输出错误("耗时/斐波那契", t1 - t0)
输出错误("耗时/循环求和", t2 - t1)
输出错误("耗时/素数计数", t3 - t2)
输出错误("耗时/字符串搓", t4 - t3)
输出错误("耗时/合计", t4 - t0)
