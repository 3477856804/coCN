# ============================================================
# 核心测试：运算、控制流、函数、列表、字典
# ============================================================

# --- 算术与优先级 ---
断言相等(2 + 3 * 4, 14, "乘法优先")
断言相等((2 + 3) * 4, 20, "括号优先")
断言相等(7 % 3, 1, "取模")
断言相等(7 / 2, 3.5, "除法产生浮点")
断言相等(-5 + 3, -2, "负数运算")
断言相等(2 * -3, -6, "乘负数")

# --- 比较与逻辑 ---
断言(1 < 2, "小于")
断言(2 >= 2, "大于等于")
断言("甲" == "甲", "字符串相等")
断言(1 == 1 且 2 == 2, "逻辑与")
断言(1 == 2 或 3 == 3, "逻辑或")
断言相等(1 == 2 且 1 == 1, 0, "与的短路结果")

# --- 布尔字面量 ---
断言(真, "真为真")
断言相等(假, 0, "假等于 0")
断言相等(真, 1, "真等于 1")

# --- 条件分支 ---
整数 x = 10
整数 结果 = 0
如果 x > 5
    结果 = 1
否则
    结果 = 2
结束
断言相等(结果, 1, "如果分支")

若 x == 10 结果 = 99
断言相等(结果, 99, "若 单行糖")

# --- 循环 ---
整数 和 = 0
对于 i 从 1 到 10 循环
    和 = 和 + i
结束
断言相等(和, 55, "计数循环求和")

整数 步进 = 0
对于 i 从 0 到 10 步长 2 循环
    步进 = 步进 + 1
结束
断言相等(步进, 6, "步长循环次数")

整数 倒数 = 0
对于 i 从 5 到 1 步长 -1 循环
    倒数 = 倒数 + i
结束
断言相等(倒数, 15, "倒序循环")

# --- 跳出与继续 ---
整数 计数 = 0
对于 i 从 1 到 100 循环
    如果 i > 5
        跳出
    结束
    计数 = 计数 + 1
结束
断言相等(计数, 5, "跳出生效")

整数 奇数和 = 0
对于 i 从 1 到 10 循环
    如果 i % 2 == 0
        继续
    结束
    奇数和 = 奇数和 + i
结束
断言相等(奇数和, 25, "继续生效")

# --- 当循环 ---
整数 n = 1
当 n < 100 循环
    n = n * 2
结束
断言相等(n, 128, "当循环终止条件")

# --- 函数：递归、多参、返回 ---
函数 阶乘(整数 n) -> 整数
    若 n <= 1 返回 1
    返回 n * 阶乘(n - 1)
结束
断言相等(阶乘(5), 120, "递归阶乘")
断言相等(阶乘(0), 1, "阶乘边界")

函数 斐波(整数 n) -> 整数
    若 n < 2 返回 n
    返回 斐波(n - 1) + 斐波(n - 2)
结束
断言相等(斐波(10), 55, "递归斐波那契")

函数 三数最大(a, b, c)
    整数 m = a
    若 b > m m = b
    若 c > m m = c
    返回 m
结束
断言相等(三数最大(3, 9, 5), 9, "多参函数")

# --- 列表 ---
列表 lst = [10, 20, 30]
断言相等(长度(lst), 3, "列表长度")
断言相等(lst[0], 10, "列表首元素")
断言相等(lst[-1], 30, "列表负索引")
lst[1] = 99
断言相等(lst[1], 99, "列表元素赋值")
断言相等(包含(lst, 30), 1, "列表包含")
断言相等(包含(lst, 77), 0, "列表不包含")

列表 嵌套 = [[1, 2], [3, 4]]
断言相等(嵌套[1][0], 3, "嵌套列表索引")

# --- 字典 ---
字典 d = {"甲": 1, "乙": 2}
断言相等(d["甲"], 1, "字典取值")
断言相等(长度(d), 2, "字典长度")
d["丙"] = 3
断言相等(d["丙"], 3, "字典新增键")
断言相等(包含(d, "乙"), 1, "字典包含键")
断言相等(包含(d, "丁"), 0, "字典不含键")

# --- 类型内省与转换 ---
断言相等(类型(1), "整数", "整数类型名")
断言相等(类型(1.5), "浮点", "浮点类型名")
断言相等(类型("甲"), "字符串", "字符串类型名")
断言相等(类型([1]), "列表", "列表类型名")
断言相等(转整数("42"), 42, "字符串转整数")
断言相等(转浮点("2.5"), 2.5, "字符串转浮点")
断言相等(转字符串(42), "42", "整数转字符串")

# --- 数学函数 ---
断言相等(绝对值(-5), 5, "绝对值")
断言相等(最大值(3, 7), 7, "最大值")
断言相等(最小值(3, 7), 3, "最小值")
断言相等(平方根(16), 4, "平方根")

# 四种取整语义各司其职，不再靠一个含糊的"取整"
断言相等(取整(3.7), 4, "取整=四舍五入")
断言相等(取整(3.2), 3, "取整向下")
断言相等(取整(-3.7), -4, "取整负数")
断言相等(向下取整(3.7), 3, "向下取整")
断言相等(向下取整(-3.2), -4, "向下取整负数")
断言相等(向上取整(3.2), 4, "向上取整")
断言相等(向上取整(-3.7), -3, "向上取整负数")
断言相等(截断(3.7), 3, "截断")
断言相等(截断(-3.7), -3, "截断负数")

断言相等(幂(2, 10), 1024, "整数幂")
断言相等(类型(幂(2, 10)), "整数", "整数幂保持整数类型")
断言相等(幂(4, 0.5), 2, "分数幂")
断言相等(符号(-9), -1, "符号负")
断言相等(符号(0), 0, "符号零")
断言(绝对值(正弦(0)) < 0.000001, "正弦零点")
断言(绝对值(余弦(0) - 1) < 0.000001, "余弦零点")
断言(绝对值(自然对数(圆周率() * 0 + 1)) < 0.000001, "自然对数1为0")
断言(绝对值(自然对数(8, 2) - 3) < 0.000001, "以2为底的对数")
断言(绝对值(圆周率() - 3.14159265) < 0.00001, "圆周率")

# 最大值/最小值接受列表参数，并保持整数类型
断言相等(最大值([3, 9, 5]), 9, "列表求最大")
断言相等(最小值([3, 9, 5]), 3, "列表求最小")
断言相等(类型(最大值(3, 7)), "整数", "整数最大值不退化为浮点")

输出 "核心测试：全部通过"
