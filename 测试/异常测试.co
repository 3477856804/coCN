# ============================================================
# 异常处理回归测试（尝试 / 捕获 / 最终 / 抛出）
#
# 这套测试的重点不只是"能捕获"，更是【捕获之后解释器状态是否还是干净的】：
#   1) 内存：longjmp 会跳过一路上的 val_free 与 env_release，
#      靠引用记账精确回滚，任何一条失败都会在 ASan 下暴露为泄漏或悬空
#   2) 执行状态：调用深度、循环控制、返回标志必须复原，
#      否则"捕获一次异常"之后程序会莫名其妙地报递归过深或提前返回
#   3) 逃逸语义：尝试 块里已经写进外层列表/字典/变量的值必须留下来，
#      不能被回滚误杀
# ============================================================

# ---------- 内建运行时错误全都可以捕获 ----------
变量 捕到 = ""
尝试
    变量 x = 1 / 0
捕获 错误
    捕到 = 错误["消息"]
结束
断言相等(捕到, "除以零", "除以零可被捕获")

尝试
    变量 y = 5 % 0
捕获 错误
    捕到 = 错误["消息"]
结束
断言相等(捕到, "取模的除数为零", "取模除零可被捕获")

尝试
    变量 表 = [1, 2, 3]
    变量 z = 表[99]
捕获 错误
    捕到 = 错误["消息"]
结束
断言相等(捕到, "列表索引越界: 99 (列表长度 3)", "越界可被捕获")

尝试
    变量 t = "abc" < 5
捕获 错误
    捕到 = 错误["消息"]
结束
断言相等(捕到, "无法比较大小: 字符串 < 整数", "类型不可比可被捕获")

尝试
    变量 n = -"abc"
捕获 错误
    捕到 = 错误["消息"]
结束
断言相等(捕到, "取负需要数字或张量，得到 字符串", "取负类型错误可被捕获")

# ---------- 错误对象的结构 ----------
尝试
    变量 x = 1 / 0
捕获 e
    断言相等(类型(e), "字典", "错误对象是字典")
    断言相等(e["类型"], "运行时错误", "内建错误的类型字段")
    断言(e["行"] > 0, "错误带行号")
    断言(包含(e, "列"), "错误带列号")
结束

# ---------- 主动抛出 ----------
尝试
    抛出 "自定义故障"
捕获 e
    断言相等(e["类型"], "抛出", "主动抛出的类型字段")
    断言相等(e["消息"], "自定义故障", "主动抛出的消息")
结束

# 抛出非字符串：自动转成消息文本
尝试
    抛出 404
捕获 e
    断言相等(e["消息"], "404", "抛出整数被转为文本")
结束

# 抛出字典：原样传递（可携带自定义字段）
尝试
    抛出 {"类型": "业务错误", "消息": "余额不足", "余额": 3}
捕获 e
    断言相等(e["类型"], "业务错误", "抛出字典保留自定义类型")
    断言相等(e["余额"], 3, "抛出字典保留自定义字段")
结束

# ---------- 捕获变量可以省略 ----------
变量 进过 = 假
尝试
    抛出 "无所谓"
捕获
    进过 = 真
结束
断言(进过, "捕获可以不带变量名")

# ---------- 最终 块 ----------
变量 轨迹 = []
尝试
    追加(轨迹, "试")
最终
    追加(轨迹, "终")
结束
断言相等(轨迹, ["试", "终"], "无异常时最终块也执行")

轨迹 = []
尝试
    追加(轨迹, "试")
    抛出 "断"
捕获
    追加(轨迹, "捕")
最终
    追加(轨迹, "终")
结束
断言相等(轨迹, ["试", "捕", "终"], "异常时的执行顺序：试→捕→终")

# 只有 最终 没有 捕获：清理后异常继续向外传播
轨迹 = []
尝试
    尝试
        抛出 "往外传"
    最终
        追加(轨迹, "清理")
    结束
捕获 e
    追加(轨迹, e["消息"])
结束
断言相等(轨迹, ["清理", "往外传"], "只清理不捕获时异常继续传播")

# ---------- 嵌套与再抛出 ----------
尝试
    尝试
        变量 x = 1 / 0
    捕获 内
        抛出 "包装：" + 内["消息"]
    结束
捕获 外
    捕到 = 外["消息"]
结束
断言相等(捕到, "包装：除以零", "捕获块内可以再抛出")

# ---------- 跨函数调用栈捕获 ----------
函数 底层()
    抛出 "来自底层"
结束
函数 中层()
    返回 底层()
结束
函数 顶层()
    返回 中层()
结束
尝试
    顶层()
捕获 e
    捕到 = e["消息"]
结束
断言相等(捕到, "来自底层", "异常穿过三层函数调用")

# 深递归中抛出：验证调用深度计数在捕获后正确复原
函数 递(整数 n)
    如果 n <= 0 则
        抛出 "触底"
    结束
    返回 递(n - 1)
结束
尝试
    递(200)
捕获 e
    捕到 = e["消息"]
结束
断言相等(捕到, "触底", "深递归中抛出可被捕获")
# 关键：上一步若没复原 g_call_depth，这里会误报"递归过深"
尝试
    递(200)
捕获 e
    捕到 = e["消息"]
结束
断言相等(捕到, "触底", "捕获后调用深度已复原，可再次深递归")

# ---------- 函数内 尝试 与 返回 ----------
函数 安全除(数字 a, 数字 b)
    尝试
        返回 a / b
    捕获 e
        返回 -1
    结束
结束
断言相等(安全除(10, 2), 5, "安全除法正常分支")
断言相等(安全除(10, 0), -1, "安全除法异常分支返回兜底值")

函数 带最终(整数 x, 列表 记)
    尝试
        如果 x < 0 则
            抛出 "负数"
        结束
        追加(记, "正常")
        返回 x
    捕获
        追加(记, "出错")
        返回 0
    最终
        追加(记, "收尾")
    结束
结束
变量 记录 = []
断言相等(带最终(7, 记录), 7, "返回值穿过最终块")
断言相等(记录, ["正常", "收尾"], "返回时最终块仍然执行")
记录 = []
断言相等(带最终(-1, 记录), 0, "异常分支的返回值")
断言相等(记录, ["出错", "收尾"], "捕获后最终块仍然执行")

# ---------- 循环中的 尝试 ----------
变量 结果 = []
对于 i 从 1 到 6 循环
    尝试
        如果 i % 2 == 0 则
            抛出 "偶" + 转字符串(i)
        结束
        追加(结果, i)
    捕获 e
        追加(结果, e["消息"])
    结束
结束
断言相等(结果, [1, "偶2", 3, "偶4", 5, "偶6"], "循环内逐轮捕获")

# 循环控制穿过 尝试：跳出 / 继续 必须照常生效
变量 累计 = 0
对于 i 从 1 到 10 循环
    尝试
        如果 i == 4 则
            跳出
        结束
        累计 = 累计 + i
    捕获
        累计 = -999
    结束
结束
断言相等(累计, 6, "跳出可以穿过尝试块")

累计 = 0
对于 i 从 1 到 5 循环
    尝试
        如果 i % 2 == 0 则
            继续
        结束
        累计 = 累计 + i
    捕获
        累计 = -999
    结束
结束
断言相等(累计, 9, "继续可以穿过尝试块")

# ---------- 逃逸语义：写进外层容器的值必须留下 ----------
变量 外层表 = [10]
变量 外层典 = {"初": 1}
尝试
    追加(外层表, 20)
    追加(外层表, "拼" + "接")
    外层典["新"] = "值"
    抛出 "中断"
捕获
    进过 = 真
结束
断言相等(长度(外层表), 3, "尝试块内写入外层列表的元素被保留")
断言相等(外层表[2], "拼接", "逃逸的拼接字符串内容完好")
断言相等(外层典["新"], "值", "尝试块内写入外层字典的键被保留")

# 尝试块内成功赋值的变量在块外依然可见
尝试
    变量 半途 = "已赋值"
    抛出 "之后才出错"
捕获
    进过 = 真
结束
断言相等(半途, "已赋值", "抛出前已完成的赋值保持有效")

# ---------- 压力：反复捕获不应累积任何残留 ----------
函数 转文本(任意 v) -> 字符串
    返回 转字符串(v)
结束
函数 平方(整数 x) -> 整数
    返回 x * x
结束

变量 次数 = 0
对于 i 从 1 到 300 循环
    尝试
        变量 临时 = [i, i * 2, "文本" + 转字符串(i)]
        变量 映射结果 = 映射(临时, 转文本)
        抛出 "第" + 转字符串(i) + "轮"
    捕获 e
        次数 = 次数 + 1
    结束
结束
断言相等(次数, 300, "300 轮抛出与捕获全部命中")

# 压力：捕获后继续正常使用语言的各种功能
变量 校验 = 映射([1, 2, 3], 平方)
断言相等(校验, [1, 4, 9], "捕获之后高阶函数依旧正常")
断言相等(求和([1, 2, 3, 4]), 10, "捕获之后求和依旧正常")
断言相等(排序([3, 1, 2]), [1, 2, 3], "捕获之后排序依旧正常")

# ---------- 内建函数的参数错误同样可捕获 ----------
尝试
    变量 坏 = 平方根("不是数字")
捕获 e
    捕到 = e["类型"]
结束
断言相等(捕到, "运行时错误", "内建函数参数错误可被捕获")

# ---------- 未定义变量与未知函数 ----------
尝试
    变量 v = 完全不存在的变量
捕获 e
    捕到 = e["消息"]
结束
断言(开头是(捕到, "未定义变量"), "未定义变量可被捕获")

# ---------- 异常与模式匹配配合 ----------
函数 分类(整数 码)
    尝试
        如果 码 == 0 则
            抛出 "零错误"
        否则如果 码 < 0 则
            抛出 "负错误"
        结束
        返回 "正常"
    捕获 e
        匹配 e["消息"]
            情况 "零错误": 返回 "零"
            情况 "负错误": 返回 "负"
            默认: 返回 "未知"
        结束
    结束
结束
断言相等(分类(5), "正常", "分类正常分支")
断言相等(分类(0), "零", "捕获后可用模式匹配分流")
断言相等(分类(-3), "负", "捕获后模式匹配负分支")

# ---------- 栈守卫：无限递归必须变成可捕获的错误，而不是段错误 ----------
# 关键点：报错后栈已回退，程序必须能继续正常跑，不能留下任何残破状态。
函数 无限递归(整数 n) -> 整数
    返回 无限递归(n + 1)
结束

变量 栈错误 = ""
尝试
    变量 忽略 = 无限递归(1)
捕获 e
    栈错误 = e["消息"]
结束
断言(包含(栈错误, "调用栈"), "无限递归被栈守卫拦住并可捕获")

# 栈耗尽之后，语言的一切功能都必须完好
断言相等(1 + 2 * 3, 7, "栈回退后算术正常")
断言相等(长度([1, 2, 3]), 3, "栈回退后列表正常")
断言相等(转字符串(42), "42", "栈回退后内建函数正常")
变量 回退后表 = [1]
追加(回退后表, 2)
断言相等(回退后表, [1, 2], "栈回退后容器写入正常")

# 连续多次触发栈耗尽也不能累积损坏
对于 轮 从 1 到 3 循环
    尝试
        变量 丢弃 = 无限递归(1)
    捕获 e2
        断言(包含(e2["消息"], "调用栈"), "第 " + 转字符串(轮) + " 次栈耗尽仍可捕获")
    结束
结束
断言相等(求和([1, 2, 3, 4]), 10, "反复栈耗尽后求和仍正确")

# ---------- 数值安全：不得把非数字当数字算 ----------
# 曾经 平方根("文本") 返回 9.71224e+06（把字符串指针当数字），是最危险的一类缺陷
尝试
    变量 坏 = 平方根("不是数字")
    断言(假, "平方根接受了字符串，回归！")
捕获 e3
    断言(包含(e3["消息"], "数字"), "数学函数拒绝非数字参数")
结束

尝试
    变量 越界 = 取(全零([4]), 999)
    断言(假, "张量索引越界未被拦住，回归！")
捕获 e4
    断言(包含(e4["消息"], "越界"), "张量索引越界被拦住")
结束

尝试
    变量 坏形状 = 全零([0])
    断言(假, "零维度未被拦住，回归！")
捕获 e5
    断言(包含(e5["消息"], "正整数"), "张量维度必须是正整数")
结束

# 张量负索引应当合法（-1 表示最后一个元素）
变量 张 = 全零([3])
置(张, -1, 7.5)
断言相等(取(张, -1), 7.5, "张量支持负索引")
断言相等(取(张, 2), 7.5, "负索引与正索引指向同一元素")

输出 "异常测试：全部通过"
