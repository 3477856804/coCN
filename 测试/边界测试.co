# ============================================================
# 边界测试：专门用来暴露语言的深层缺陷
# ============================================================

# ---------- 嵌套循环 + 跳出/继续 只影响最内层 ----------
整数 内计数 = 0
整数 外计数 = 0
对于 i 从 1 到 3 循环
    外计数 = 外计数 + 1
    对于 j 从 1 到 10 循环
        如果 j > 2
            跳出
        结束
        内计数 = 内计数 + 1
    结束
结束
断言相等(外计数, 3, "内层跳出不影响外层循环")
断言相等(内计数, 6, "内层跳出次数正确")

整数 累 = 0
对于 i 从 1 到 3 循环
    对于 j 从 1 到 4 循环
        如果 j == 2
            继续
        结束
        累 = 累 + 1
    结束
结束
断言相等(累, 9, "内层继续每轮只跳一次")

# ---------- 当循环里的 继续 ----------
整数 k = 0
整数 和2 = 0
当 k < 10 循环
    k = k + 1
    如果 k % 2 == 0
        继续
    结束
    和2 = 和2 + k
结束
断言相等(和2, 25, "当循环中的继续")
断言相等(k, 10, "当循环正常终止")

# ---------- 当循环里的 跳出 ----------
整数 m = 0
当 真 循环
    m = m + 1
    如果 m >= 7
        跳出
    结束
结束
断言相等(m, 7, "当循环中的跳出")

# ---------- 函数体内的循环控制不污染调用处 ----------
函数 内部循环()
    整数 s = 0
    对于 i 从 1 到 5 循环
        如果 i == 3
            跳出
        结束
        s = s + i
    结束
    返回 s
结束

整数 外和 = 0
对于 i 从 1 到 4 循环
    外和 = 外和 + 内部循环()
结束
断言相等(内部循环(), 3, "函数内跳出结果正确")
断言相等(外和, 12, "被调函数的跳出不会终止调用处循环")

# ---------- 循环中 返回 能穿透并立即结束函数 ----------
函数 首个大于(列表 表, 整数 界)
    对于 i 从 0 到 长度(表) - 1 循环
        如果 表[i] > 界
            返回 表[i]
        结束
    结束
    返回 -1
结束
断言相等(首个大于([1, 5, 9], 4), 5, "循环内返回")
断言相等(首个大于([1, 2], 100), -1, "循环内未命中走兜底返回")

函数 双层查找(整数 目标)
    对于 i 从 1 到 5 循环
        对于 j 从 1 到 5 循环
            如果 i * j == 目标
                返回 i * 100 + j
            结束
        结束
    结束
    返回 0
结束
断言相等(双层查找(12), 304, "双层循环内返回穿透两层")

# ---------- 递归 ----------
函数 累加到(整数 n) -> 整数
    若 n <= 0 返回 0
    返回 n + 累加到(n - 1)
结束
断言相等(累加到(100), 5050, "深度 100 递归")
断言相等(累加到(500), 125250, "深度 500 递归")

函数 互甲(整数 n)
    若 n <= 0 返回 0
    返回 1 + 互乙(n - 1)
结束
函数 互乙(整数 n)
    若 n <= 0 返回 0
    返回 1 + 互甲(n - 1)
结束
断言相等(互甲(50), 50, "互相递归")

# ---------- 运算符与优先级 ----------
断言相等(2 + 3 * 4 - 6 / 3, 12, "混合优先级")
断言相等(-2 * -3, 6, "双负号")
断言相等(10 // 3, 3, "整除")
断言相等(-10 // 3, -4, "整除向下取整")
断言相等(10 % 3, 1, "取模")
断言相等(2 * 3 % 4, 2, "乘与取模同级左结合")
断言相等(1 + 2 < 4, 1, "算术优先于比较")
断言相等(真 且 假 或 真, 1, "与优先于或")
断言相等(1 != 2, 1, "不等于")
断言相等(2 <= 2, 1, "小于等于")
断言相等(3 >= 4, 0, "大于等于为假")

# ---------- 浮点与整数边界 ----------
断言相等(7 / 2, 3.5, "真除法")
断言相等(类型(7 / 2), "浮点", "真除法返回浮点")
断言相等(类型(7 // 2), "整数", "整除返回整数")
断言相等(类型(1 + 1), "整数", "整数加法保持整数")
断言相等(类型(1 + 1.0), "浮点", "整浮混合提升为浮点")
断言(绝对值(0.1 + 0.2 - 0.3) < 0.000001, "浮点累积误差在容差内")

# ---------- 字符串转义 ----------
字符串 带换行 = "甲\n乙"
断言相等(长度(带换行), 3, "换行转义算一个字符")
断言相等(字符码(带换行, 1), 10, "换行转义码点为 10")
断言相等(长度("制表\t符"), 4, "制表转义")
断言相等(长度("引号\"内"), 4, "引号转义")
断言相等(长度("反斜杠\\后"), 5, "反斜杠转义")
断言相等(字符码("反斜杠\\后", 3), 92, "反斜杠码点为 92")

# ---------- 空容器 ----------
列表 空表 = []
断言相等(长度(空表), 0, "空列表长度")
断言相等(累加(空表), 0, "空列表累加为 0")
断言相等(长度(唯一(空表)), 0, "空列表去重")
断言相等(连接(空表, "-"), "", "空列表连接")
追加(空表, 1)
断言相等(长度(空表), 1, "空列表可追加")

字典 空表2 = {}
断言相等(长度(空表2), 0, "空字典长度")
断言相等(长度(键(空表2)), 0, "空字典无键")
空表2["新"] = 1
断言相等(空表2["新"], 1, "空字典可写入")

断言相等(长度(""), 0, "空串长度")
断言相等(反转(""), "", "空串反转")
断言相等(去空白("   "), "", "全空白去空白后为空")

# ---------- 负索引与嵌套访问 ----------
列表 深 = [[1, [2, 3]], [4, [5, 6]]]
断言相等(深[0][1][1], 3, "三层嵌套索引")
断言相等(深[-1][-1][-1], 6, "三层负索引")
断言相等("中华人民"[-1], "民", "字符串负索引")
断言相等("中华人民"[0], "中", "字符串正索引")

字典 混 = {"表": [1, 2, 3]}
断言相等(混["表"][1], 2, "字典里取列表再索引")
断言相等(长度(混["表"]), 3, "字典里的列表长度")

# ---------- 函数作为值传递 ----------
函数 加一(整数 x) -> 整数
    返回 x + 1
结束
函数 应用两次(f, 整数 x)
    返回 f(f(x))
结束
断言相等(应用两次(加一, 5), 7, "函数作为参数传递并调用")

列表 函表 = [加一, 加一]
断言相等(函表[0](10), 11, "从列表中取出函数调用")
断言相等(长度(函表), 2, "函数列表长度")

# ---------- 高阶函数与闭包式用法 ----------
函数 平方(整数 x) -> 整数
    返回 x * x
结束
断言相等(累加(映射(范围(1, 6), 平方)), 55, "映射平方后求和")
断言相等(长度(过滤(范围(1, 21), 是三倍)), 6, "过滤三倍数")

函数 是三倍(整数 x) -> 布尔
    返回 x % 3 == 0
结束

# ---------- 推导式 ----------
列表 平方表 = [x * x 对于 x 在 范围(1, 6)]
断言相等(长度(平方表), 5, "列表推导式长度")
断言相等(平方表[4], 25, "列表推导式元素")

列表 偶数表 = [x 对于 x 在 范围(1, 11) 如果 x % 2 == 0]
断言相等(长度(偶数表), 5, "带条件的列表推导式")
断言相等(累加(偶数表), 30, "条件推导式求和")

字典 长度表 = {w: 长度(w) 对于 w 在 ["甲", "甲乙", "甲乙丙"]}
断言相等(长度(长度表), 3, "字典推导式键数")
断言相等(长度表["甲乙"], 2, "字典推导式按变量取键")
断言相等(长度表["甲乙丙"], 3, "字典推导式中文长度按字符计")

# ---------- 模式匹配 ----------
函数 说数(整数 n)
    字符串 结果 = "未匹配"
    匹配 n
        情况 1: 结果 = "一"
        情况 2: 结果 = "二"
        默认: 结果 = "多"
    结束
    返回 结果
结束
断言相等(说数(1), "一", "匹配情况1")
断言相等(说数(2), "二", "匹配情况2")
断言相等(说数(9), "多", "匹配默认分支")

# 是 与 情况 是同义词
函数 说数2(整数 n)
    字符串 r = "?"
    匹配 n
        是 1: r = "壹"
        默认: r = "其他"
    结束
    返回 r
结束
断言相等(说数2(1), "壹", "是 关键字匹配")
断言相等(说数2(5), "其他", "是 关键字默认分支")

# 字符串也能匹配
函数 判色(字符串 s)
    字符串 r = "未知"
    匹配 s
        情况 "红": r = "暖色"
        情况 "蓝": r = "冷色"
        默认: r = "其他"
    结束
    返回 r
结束
断言相等(判色("红"), "暖色", "字符串匹配")
断言相等(判色("蓝"), "冷色", "字符串匹配2")
断言相等(判色("绿"), "其他", "字符串匹配默认")

输出 "边界测试：全部通过"
