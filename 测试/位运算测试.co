# ============================================================
# 位运算与进制字面量回归测试（系统编程基石）
#
# 这套测试盯死三件事：
#   1) 语义正确：& | ^ ~ << >> 的结果必须与 C 逐位一致，
#      负数右移必须是【算术移位】（符号填充），不能随平台漂移
#   2) 优先级正确：与 C 完全一致 —— * / 高于 + - 高于 << >> 高于
#      比较 高于 == 高于 & 高于 ^ 高于 | 高于 且 高于 或。
#      优先级写错的语言，写出来的掩码代码全是暗坑
#   3) 拒绝未定义行为：移位位数为负或 >63 必须报中文错误，
#      浮点参与位运算必须报错而不是静默截断
# ============================================================

# ---------- 基本按位运算 ----------
断言相等(12 & 10, 8, "按位与：1100 & 1010 = 1000")
断言相等(12 | 10, 14, "按位或：1100 | 1010 = 1110")
断言相等(12 ^ 10, 6, "按位异或：1100 ^ 1010 = 0110")
断言相等(~0, -1, "按位取反：~0 = -1（补码）")
断言相等(~5, -6, "按位取反：~5 = -6")
断言相等(~(-1), 0, "按位取反可逆")

# ---------- 中文别名与符号完全等价 ----------
断言相等(12 按位与 10, 12 & 10, "按位与 等价于 &")
断言相等(12 按位或 10, 12 | 10, "按位或 等价于 |")
断言相等(12 按位异或 10, 12 ^ 10, "按位异或 等价于 ^")
断言相等(按位取反 5, ~5, "按位取反 等价于 ~")
断言相等(1 左移 10, 1 << 10, "左移 等价于 <<")
断言相等(1024 右移 3, 1024 >> 3, "右移 等价于 >>")

# ---------- 移位 ----------
断言相等(1 << 0, 1, "左移 0 位不变")
断言相等(1 << 10, 1024, "1 << 10 = 1024")
断言相等(1 << 62, 4611686018427387904, "左移到第 62 位仍精确")
断言相等(1024 >> 3, 128, "右移 3 位")
断言相等(7 >> 1, 3, "正数右移向下取整")
# 最小整数没有正的字面量形式（9223372036854775808 已越界，词法期就会拒绝），
# 所以用 0 - 最大值 - 1 表达，同时验证左移到符号位是补码回绕而非未定义行为
断言(1 << 63 < 0, "左移到符号位得到负数")
断言相等(1 << 63, 0 - 9223372036854775807 - 1, "1 << 63 就是最小整数")
断言相等((1 << 63) >> 63, -1, "最小整数算术右移 63 位是 -1")

# 负数右移必须是算术移位：符号位持续填充，-1 右移永远是 -1
断言相等(-8 >> 1, -4, "负数右移是算术移位")
断言相等(-8 >> 3, -1, "负数右移最终收敛到 -1")
断言相等(-1 >> 63, -1, "-1 右移任意位仍是 -1")
断言相等(-1024 >> 5, -32, "负数右移保持符号")

# ---------- 布尔按 0/1 参与 ----------
断言相等(真 & 真, 1, "真 & 真 = 1")
断言相等(真 | 假, 1, "真 | 假 = 1")
断言相等(真 ^ 真, 0, "真 ^ 真 = 0")
断言相等(真 << 3, 8, "布尔可作为移位的左操作数")

# ---------- 优先级：必须与 C 一致 ----------
# << 低于 + ：1 << 2 + 3 等于 1 << 5 = 32，而不是 (1<<2)+3 = 7
断言相等(1 << 2 + 3, 32, "移位优先级低于加法")
断言相等((1 << 2) + 3, 7, "括号可改变结合")
# & 低于比较：1 & 2 == 2 等于 1 & (2==2) = 1 & 真 = 1
断言相等(1 & 2 == 2, 1, "按位与优先级低于相等比较")
# | 低于 ^ 低于 &
断言相等(1 | 2 ^ 3 & 1, 3, "| 低于 ^ 低于 &")
断言相等(1 | 6 & 3, 3, "按位与先算")
# 且 / 或 低于所有位运算
断言相等(1 & 0 或 真, 真, "逻辑或优先级最低")
断言相等(转布尔(4 & 4) 且 真, 真, "逻辑与优先级低于按位与")
# 一元 ~ 紧邻操作数
断言相等(~5 & 255, 250, "一元取反先于按位与")
断言相等(-1 & 255, 255, "负数按位与掩码")

# ---------- 进制字面量 ----------
断言相等(0xFF, 255, "十六进制字面量")
断言相等(0xff, 255, "十六进制大小写等价")
断言相等(0x7FFFFFFFFFFFFFFF, 9223372036854775807, "十六进制可达最大整数")
断言相等(0b1010, 10, "二进制字面量")
断言相等(0b1111_1111, 255, "下划线分隔符")
断言相等(0o777, 511, "八进制字面量")
断言相等(1_000_000, 1000000, "十进制也支持下划线")
断言相等(3.14, 3.14, "浮点解析未被破坏")
断言相等(1_0.5, 10.5, "浮点也支持下划线")
断言相等(0xDEAD_BEEF, 3735928559, "典型魔数")

# ---------- 进制格式化与位工具 ----------
断言相等(十六进制(255), "0xff", "十六进制格式化")
断言相等(十六进制(255, 4), "0x00ff", "十六进制补零宽度")
断言相等(十六进制(0), "0x0", "零的十六进制")
断言相等(十六进制(-1), "0xffffffffffffffff", "负数按 64 位补码呈现")
断言相等(二进制(10), "0b1010", "二进制格式化")
断言相等(二进制(5, 8), "0b00000101", "二进制补齐 8 位")
断言相等(八进制(511), "0o777", "八进制格式化")
断言相等(位计数(255), 8, "位计数：0xFF 有 8 个 1")
断言相等(位计数(0), 0, "位计数：0 没有 1")
断言相等(位计数(-1), 64, "位计数：-1 是 64 个 1")
断言相等(取位(0b1010, 1), 1, "取位：第 1 位是 1")
断言相等(取位(0b1010, 0), 0, "取位：第 0 位是 0")
断言相等(置位(0, 3, 1), 8, "置位：把第 3 位置 1")
断言相等(置位(255, 0, 0), 254, "置位：把第 0 位清 0")
变量 原值 = 255
变量 改后 = 置位(原值, 0, 0)
断言相等(原值, 255, "置位不修改原值")
断言相等(改后, 254, "置位返回新值")

# ---------- 掩码实战：拆装一个 32 位像素 ----------
函数 打包颜色(红, 绿, 蓝, 透明)
    返回 (红 << 24) | (绿 << 16) | (蓝 << 8) | 透明
结束
函数 取分量(像素, 位移)
    返回 (像素 >> 位移) & 0xFF
结束
变量 像素 = 打包颜色(0x12, 0x34, 0x56, 0x78)
断言相等(像素, 0x12345678, "打包 32 位像素")
断言相等(取分量(像素, 24), 0x12, "拆出红色分量")
断言相等(取分量(像素, 16), 0x34, "拆出绿色分量")
断言相等(取分量(像素, 8), 0x56, "拆出蓝色分量")
断言相等(取分量(像素, 0), 0x78, "拆出透明分量")
断言相等(十六进制(像素, 8), "0x12345678", "格式化回原样")

# ---------- 位运算实战：无乘除法的算法 ----------
# 快速幂：用移位与按位与判断二进制位
函数 快速幂(底, 幂)
    变量 结果 = 1
    变量 b = 底
    变量 e = 幂
    当 e > 0 循环
        如果 (e & 1) == 1 则
            结果 = 结果 * b
        结束
        b = b * b
        e = e >> 1
    结束
    返回 结果
结束
断言相等(快速幂(2, 10), 1024, "快速幂 2^10")
断言相等(快速幂(3, 5), 243, "快速幂 3^5")
断言相等(快速幂(7, 0), 1, "快速幂零次方")

# 异或交换：不借助临时变量
变量 甲 = 123
变量 乙 = 456
甲 = 甲 ^ 乙
乙 = 甲 ^ 乙
甲 = 甲 ^ 乙
断言相等(甲, 456, "异或交换：甲")
断言相等(乙, 123, "异或交换：乙")

# 判断 2 的幂：n & (n-1) == 0
函数 是二的幂(n)
    返回 n > 0 且 (n & (n - 1)) == 0
结束
断言(是二的幂(1), "1 是 2 的幂")
断言(是二的幂(1024), "1024 是 2 的幂")
断言(非 是二的幂(1000), "1000 不是 2 的幂")
断言(非 是二的幂(0), "0 不是 2 的幂")

# CRC32 风格的逐位运算（校验位运算组合的正确性）
函数 简易散列(文本)
    变量 h = 0x811C9DC5
    对于 i 从 0 到 长度(文本) - 1 循环
        h = h ^ 字符码(文本[i])
        h = (h * 16777619) & 0xFFFFFFFF
    结束
    返回 h
结束
变量 h1 = 简易散列("你好")
变量 h2 = 简易散列("你好")
变量 h3 = 简易散列("世界")
断言相等(h1, h2, "同样输入散列相同")
断言(h1 != h3, "不同输入散列不同")
断言(h1 >= 0 且 h1 <= 0xFFFFFFFF, "散列值落在 32 位范围内")

# ---------- 位运算错误路径可被捕获 ----------
变量 错1 = ""
尝试
    变量 t = 1 << -1
捕获 错误
    错1 = 错误["消息"]
结束
断言(包含(错1, "移位位数不能为负"), "负移位报错")

变量 错2 = ""
尝试
    变量 t = 1 << 64
捕获 错误
    错2 = 错误["消息"]
结束
断言(包含(错2, "移位位数超出范围"), "移位位数过大报错")

变量 错3 = ""
尝试
    变量 t = 1.5 & 1
捕获 错误
    错3 = 错误["消息"]
结束
断言(包含(错3, "位运算"), "浮点参与位运算报错")

变量 错4 = ""
尝试
    变量 t = ~1.5
捕获 错误
    错4 = 错误["消息"]
结束
断言(包含(错4, "按位取反"), "浮点取反报错")

变量 错5 = ""
尝试
    变量 t = "abc" & 1
捕获 错误
    错5 = 错误["消息"]
结束
断言(包含(错5, "位运算"), "字符串参与位运算报错")

# 报错之后语言状态依然干净
断言相等(0xF0 | 0x0F, 255, "异常后位运算仍正常")

输出 "位运算测试：全部通过"
