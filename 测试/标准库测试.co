# ============================================================
# 标准库测试：列表 / 字典 / 字符串 / 高阶函数 / 文件读写
# ============================================================

# ---------- 范围 ----------
断言相等(长度(范围(5)), 5, "范围单参长度")
断言相等(范围(5)[0], 0, "范围从 0 起")
断言相等(范围(5)[4], 4, "范围右开区间")
断言相等(长度(范围(2, 8)), 6, "范围双参长度")
断言相等(范围(2, 8)[0], 2, "范围双参起点")
断言相等(长度(范围(0, 10, 3)), 4, "范围带步长")
断言相等(范围(0, 10, 3)[3], 9, "范围步长末元素")
断言相等(长度(范围(5, 0, -1)), 5, "范围倒序")
断言相等(范围(5, 0, -1)[0], 5, "范围倒序起点")

# ---------- 累加 / 反转 / 唯一 ----------
断言相等(累加([1, 2, 3, 4]), 10, "累加整数")
断言相等(类型(累加([1, 2, 3])), "整数", "累加保持整数")
断言相等(累加([1.5, 2.5]), 4, "累加浮点")
断言相等(累加(范围(1, 101)), 5050, "累加 1..100")

列表 甲 = [1, 2, 3]
反转(甲)
断言相等(甲[0], 3, "列表反转首元素")
断言相等(甲[2], 1, "列表反转末元素")
断言相等(反转("abc"), "cba", "字符串反转")
断言相等(反转("中国话"), "话国中", "中文字符串反转")

断言相等(长度(唯一([1, 2, 2, 3, 1])), 3, "唯一去重")
断言相等(唯一([1, 2, 2, 3, 1])[2], 3, "唯一保持首次顺序")

# ---------- 索引 / 插入 / 弹出 / 计数 ----------
列表 乙 = [10, 20, 30]
断言相等(索引(乙, 20), 1, "索引命中")
断言相等(索引(乙, 99), -1, "索引未命中")
插入(乙, 1, 15)
断言相等(乙[1], 15, "插入到中间")
断言相等(长度(乙), 4, "插入后长度")
插入(乙, -1, 25)
断言相等(乙[3], 25, "插入负下标")
断言相等(弹出(乙), 30, "弹出末元素")
断言相等(弹出(乙, 0), 10, "弹出指定下标")
断言相等(长度(乙), 3, "两次弹出后长度")

断言相等(计数([1, 2, 1, 1], 1), 3, "列表计数")
断言相等(计数("abcabc", "bc"), 2, "字符串子串计数")

# ---------- 切片 / 扁平 ----------
列表 丙 = [0, 1, 2, 3, 4, 5]
断言相等(长度(切片(丙, 1, 4)), 3, "切片长度")
断言相等(切片(丙, 1, 4)[0], 1, "切片起点")
断言相等(切片(丙, -2)[0], 4, "切片负起点到末尾")
断言相等(切片("中华人民", 1, 3), "华人", "字符串切片")

断言相等(长度(扁平([[1, 2], [3], [4, 5]])), 5, "扁平展开一层")
断言相等(扁平([[1, 2], [3]])[2], 3, "扁平元素顺序")

# ---------- 排序：数字 + 字符串 + 降序 ----------
列表 数 = [5, 1, 4, 2, 3]
排序(数)
断言相等(数[0], 1, "数字升序首")
断言相等(数[4], 5, "数字升序末")
排序(数, 真)
断言相等(数[0], 5, "数字降序首")

列表 词 = ["banana", "apple", "cherry"]
排序(词)
断言相等(词[0], "apple", "字符串排序不再读错联合体")
断言相等(词[2], "cherry", "字符串排序末元素")

# ---------- 字典：键 / 值 / 项 / 移除键 ----------
字典 表 = {"甲": 1, "乙": 2, "丙": 3}
断言相等(长度(键(表)), 3, "键数量")
断言相等(长度(值(表)), 3, "值数量")
断言相等(累加(值(表)), 6, "值求和")
断言相等(长度(项(表)), 3, "项数量")
断言相等(长度(项(表)[0]), 2, "项是键值对")

断言相等(移除键(表, "乙"), 1, "移除已有键返回 1")
断言相等(移除键(表, "乙"), 0, "重复移除返回 0")
断言相等(长度(表), 2, "移除后长度")
断言相等(包含(表, "乙"), 0, "移除后不再包含")
# 关键：删除后探测链必须完好，其他键仍可查到
断言相等(表["甲"], 1, "删除后其他键仍可读")
断言相等(表["丙"], 3, "删除后探测链未断裂")

# ---------- 字符串新函数 ----------
断言相等(去空白("  中间 保留  "), "中间 保留", "去两端空白")
断言相等(去左空白("  甲"), "甲", "去左空白")
断言相等(去右空白("甲  "), "甲", "去右空白")
断言相等(大写("aBc中"), "ABC中", "大写不破坏中文")
断言相等(小写("AbC中"), "abc中", "小写不破坏中文")
断言相等(重复("甲", 3), "甲甲甲", "重复")
断言相等(重复("甲", 0), "", "重复零次")
断言相等(开头是("中华人民", "中华"), 1, "开头是")
断言相等(开头是("中华人民", "人民"), 0, "开头不是")
断言相等(结尾是("中华人民", "人民"), 1, "结尾是")
断言相等(结尾是("中华人民", "中华"), 0, "结尾不是")

断言相等(字符码("A"), 65, "ASCII 码点")
断言相等(字符码("中"), 20013, "中文码点")
断言相等(码转字符(65), "A", "码点转 ASCII")
断言相等(码转字符(20013), "中", "码点转中文")
断言相等(字符码(码转字符(128512)), 128512, "四字节码点往返")

# ---------- 分割：多字节分隔符必须正确 ----------
列表 段 = 分割("甲、乙、丙", "、")
断言相等(长度(段), 3, "多字节分隔符分割数量")
断言相等(段[0], "甲", "多字节分割首段")
断言相等(段[2], "丙", "多字节分割末段")

列表 空段 = 分割("a,,b", ",")
断言相等(长度(空段), 3, "保留空字段")
断言相等(空段[1], "", "中间空字段为空串")

列表 逐字 = 分割("中文", "")
断言相等(长度(逐字), 2, "空分隔符逐字符拆分")
断言相等(逐字[1], "文", "逐字符拆分内容")

# ---------- 连接：非字符串元素自动转换，空列表安全 ----------
断言相等(连接(["甲", "乙"], "-"), "甲-乙", "连接字符串")
断言相等(连接([1, 2, 3], ","), "1,2,3", "连接数字自动转字符串")
断言相等(连接([], ","), "", "连接空列表")

# ---------- 替换：替换串更长时不再溢出 ----------
断言相等(替换("a", "a", "很长很长的一段替换文本"), "很长很长的一段替换文本", "替换为更长串")
断言相等(替换("甲乙甲", "甲", "丙"), "丙乙丙", "中文全部替换")

# ---------- 高阶函数 ----------
函数 翻倍(整数 x) -> 整数
    返回 x * 2
结束
函数 是偶数(整数 x) -> 布尔
    返回 x % 2 == 0
结束
函数 相加(a, b)
    返回 a + b
结束

列表 源 = [1, 2, 3, 4, 5]
断言相等(连接(映射(源, 翻倍), ","), "2,4,6,8,10", "映射")
断言相等(连接(过滤(源, 是偶数), ","), "2,4", "过滤")
断言相等(归约(源, 相加), 15, "归约无初值")
断言相等(归约(源, 相加, 100), 115, "归约带初值")
断言相等(全部满足([2, 4, 6], 是偶数), 1, "全部满足")
断言相等(全部满足([2, 3], 是偶数), 0, "全部满足失败")
断言相等(任一满足([1, 3, 4], 是偶数), 1, "任一满足")
断言相等(任一满足([1, 3], 是偶数), 0, "任一满足失败")
断言相等(归约(映射(范围(1, 6), 翻倍), 相加), 30, "高阶组合")

# ---------- 转字符串（原先是空壳实现） ----------
断言相等(转字符串(42), "42", "整数转字符串")
断言相等(转字符串(2.5), "2.5", "浮点转字符串")
断言相等(转字符串([1, 2]), "[1, 2]", "列表转字符串")
断言相等(转字符串("已是字符串"), "已是字符串", "字符串转字符串")
断言相等(长度(转字符串(123)), 3, "转字符串结果可测长度")

# ---------- 文件读写 ----------
字符串 路径 = "/tmp/co_文件测试.txt"
写文件(路径, "第一行\n第二行\n第三行\n")
断言相等(文件存在(路径), 1, "写入后文件存在")
断言(包含(读文件(路径), "第二行"), "读回内容正确")
追加文件(路径, "第四行\n")
列表 行 = 读取行(路径)
断言相等(行[0], "第一行", "读取行首行")
断言相等(行[3], "第四行", "追加后的末行")
断言相等(删除文件(路径), 1, "删除文件")
断言相等(文件存在(路径), 0, "删除后不存在")

写文件(路径, 12345)
断言相等(读文件(路径), "12345", "写入非字符串自动转换")
删除文件(路径)

输出 "标准库测试：全部通过"
